                            <div class="card-body">
                                <h6>Summary</h6>
                                <p><strong>Total Guests:</strong> @billGuests.Count</p>
                                <p><strong>Active Guests:</strong> @billGuests.Count(g => g.Status == 0)</p>
                                <p><strong>Checked Out Guests:</strong> @billGuests.Count(g => g.Status == 1)</p>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="text-center mt-4 text-muted">

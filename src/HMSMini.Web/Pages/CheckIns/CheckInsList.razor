    private async Task CreateCheckIn()
    {
        createErrorMessage = string.Empty;

        // Validate required fields
        if (string.IsNullOrWhiteSpace(newCheckIn.RoomNumber))
        {
            createErrorMessage = "Please select a room";
            return;
        }

        if (!newCheckIn.Guests.Any())
        {
            createErrorMessage = "Please add at least one guest";
            return;
        }

        // Validate all guests have names and valid mobile numbers
        for (int i = 0; i < newCheckIn.Guests.Count; i++)
        {
            if (string.IsNullOrWhiteSpace(newCheckIn.Guests[i].GuestName))
            {
                createErrorMessage = $"Guest {i + 1}: Name is required";
                return;
            }

            // Validate mobile number format (must be exactly 10 digits if provided)
            if (!string.IsNullOrWhiteSpace(newCheckIn.Guests[i].MobileNo))
            {
                var mobileNo = newCheckIn.Guests[i].MobileNo?.Trim() ?? string.Empty;
                if (!System.Text.RegularExpressions.Regex.IsMatch(mobileNo, @"^\d{10}$"))
                {
                    createErrorMessage = $"Guest {i + 1}: Mobile number must be exactly 10 digits";
                    return;
                }
            }
        }

        if (newCheckIn.CheckOutDate <= newCheckIn.CheckInDate)
        {
            createErrorMessage = "Check-out date must be after check-in date";
            return;
        }

        // Set company ID if selected
        if (!string.IsNullOrWhiteSpace(selectedCompanyId) && int.TryParse(selectedCompanyId, out int parsedCompanyId))
        {
            newCheckIn.CompanyId = parsedCompanyId;
        }
        else
        {
            newCheckIn.CompanyId = null;
        }

        // Set business source ID if selected
        if (!string.IsNullOrWhiteSpace(selectedBusinessSourceId) && int.TryParse(selectedBusinessSourceId, out int parsedBusinessSourceId))
        {
            newCheckIn.BusinessSourceId = parsedBusinessSourceId;
        }
        else
        {
            newCheckIn.BusinessSourceId = null;
        }

        // Set meal plan ID if selected
        if (!string.IsNullOrWhiteSpace(selectedMealPlanId) && int.TryParse(selectedMealPlanId, out int parsedMealPlanId))
        {
            newCheckIn.MealPlanId = parsedMealPlanId;
        }
        else
        {
            newCheckIn.MealPlanId = null;
        }

        // Set guest type ID if selected
        if (!string.IsNullOrWhiteSpace(selectedGuestTypeId) && int.TryParse(selectedGuestTypeId, out int parsedGuestTypeId))
        {
            newCheckIn.GuestTypeId = parsedGuestTypeId;
        }
        else
        {
            newCheckIn.GuestTypeId = null;
        }

        var result = await ApiClient.CreateCheckInAsync(newCheckIn);
        if (result != null)
        {
            await LoadCheckIns();
            HideCreateModal();
        }
        else
        {
            createErrorMessage = "Failed to create check-in. Please try again.";
        }
    }


    private async Task AddNewGuest()
    {
        if (selectedCheckIn == null) return;

        addGuestError = string.Empty;
        addGuestSuccess = string.Empty;

        // Validate guest name is required
        if (string.IsNullOrWhiteSpace(newGuest.GuestName))
        {
            addGuestError = "Guest name is required";
            return;
        }

        // Validate mobile number format (must be exactly 10 digits if provided)
        if (!string.IsNullOrWhiteSpace(newGuest.MobileNo))
        {
            var mobileNo = newGuest.MobileNo.Trim();
            if (!System.Text.RegularExpressions.Regex.IsMatch(mobileNo, @"^\d{10}$"))
            {
                addGuestError = "Mobile number must be exactly 10 digits";
                return;
            }
        }

        addingGuest = true;
        StateHasChanged();

        try
        {
            // Step 1: Create the guest
            var result = await ApiClient.AddGuestToCheckInAsync(selectedCheckIn.Id, newGuest);
            if (result != null)
            {
                addGuestSuccess = $"Guest {result.GuestName} added successfully!";
                managedGuests.Add(result);

                // Update PAX count in the selected check-in
                selectedCheckIn.Pax = managedGuests.Count;

                // Step 2: Upload photos if selected
                if (newGuestPhoto1 != null)
                {
                    try
                    {
                        using var stream1 = newGuestPhoto1.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                        using var memoryStream1 = new MemoryStream();
                        await stream1.CopyToAsync(memoryStream1);
                        memoryStream1.Position = 0;

                        var photoResult1 = await ApiClient.UploadGuestPhotoAsync(result.Id, 1, memoryStream1, newGuestPhoto1.Name);
                        if (photoResult1 != null)
                        {
                            // Update guest in the list
                            var guestIndex = managedGuests.FindIndex(g => g.Id == result.Id);
                            if (guestIndex >= 0)
                            {
                                managedGuests[guestIndex] = photoResult1;
                            }
                        }
                    }
                    catch
                    {
                        // Photo upload failed, but guest was created
                    }
                }

                if (newGuestPhoto2 != null)
                {
                    try
                    {
                        using var stream2 = newGuestPhoto2.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                        using var memoryStream2 = new MemoryStream();
                        await stream2.CopyToAsync(memoryStream2);
                        memoryStream2.Position = 0;

                        var photoResult2 = await ApiClient.UploadGuestPhotoAsync(result.Id, 2, memoryStream2, newGuestPhoto2.Name);
                        if (photoResult2 != null)
                        {
                            // Update guest in the list
                            var guestIndex = managedGuests.FindIndex(g => g.Id == result.Id);
                            if (guestIndex >= 0)
                            {
                                managedGuests[guestIndex] = photoResult2;
                            }
                        }
                    }
                    catch
                    {
                        // Photo upload failed, but guest was created
                    }
                }

                // Reset form
                newGuest = new CreateGuestDto();
                newGuestPhoto1 = null;
                newGuestPhoto2 = null;
                newGuestPhoto1Name = string.Empty;
                newGuestPhoto2Name = string.Empty;

                // Clear success message after 2 seconds
                await Task.Delay(2000);
                addGuestSuccess = string.Empty;
            }
            else
            {
                addGuestError = "Failed to add guest. Please try again.";
            }
        }
        catch (Exception ex)
        {
            addGuestError = $"Error: {ex.Message}";
        }
        finally
        {
            addingGuest = false;
            StateHasChanged();
        }
    }


                                                <td colspan="5" class="text-end"><strong>Total Additional Charges:</strong></td>
                                                <td class="text-end"><strong>₹@billPreview.AdditionalChargesSubtotal.ToString("N2")</strong></td>
                                                <td class="no-print"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

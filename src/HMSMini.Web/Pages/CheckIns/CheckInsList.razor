    private async Task ProcessCreateOcr()
    {
        if (ocrFile == null) return;

        processingOcr = true;
        createErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            if (ocrFile.Size > 10 * 1024 * 1024)
            {
                createErrorMessage = "File size must be less than 10MB";
                return;
            }

            using var stream = ocrFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            createOcrResult = await ApiClient.ProcessOcrDirectAsync(memoryStream, ocrFile.Name);

            if (createOcrResult != null)
            {
                // Auto-fill form with OCR data
                var guestDto = new CreateGuestDto
                {
                    GuestName = createOcrResult.GuestInfo.GuestName,
                    Address = createOcrResult.GuestInfo.Address,
                    City = createOcrResult.GuestInfo.City,
                    State = createOcrResult.GuestInfo.State,
                    Country = createOcrResult.GuestInfo.Country,
                    MobileNo = createOcrResult.GuestInfo.MobileNo,
                    PanOrAadharNo = createOcrResult.GuestInfo.IdNumber
                };

                if (newCheckIn.Guests.Any())
                {
                    newCheckIn.Guests[0] = guestDto;
                }
                else
                {
                    newCheckIn.Guests.Add(guestDto);
                }
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"OCR processing failed: {ex.Message}";
        }
        finally
        {
            processingOcr = false;
            StateHasChanged();
        }
    }


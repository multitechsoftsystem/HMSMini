                                            }
                                            @if (guest.ActualCheckOutDate.HasValue)
                                            {
                                                <p class="mb-1"><strong>Checked Out:</strong> @guest.ActualCheckOutDate.Value.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt")</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Summary -->

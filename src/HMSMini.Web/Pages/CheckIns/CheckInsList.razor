    private void SubmitOcrReview()
    {
        if (currentOcrReview != null && currentReviewGuest != null)
        {
            // Populate guest information from reviewed OCR data
            // Only update if extracted value is not blank, otherwise keep old value
            currentReviewGuest.GuestName = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.GuestName)
                ? currentOcrReview.GuestInfo.GuestName
                : currentReviewGuest.GuestName;

            currentReviewGuest.Address = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.Address)
                ? currentOcrReview.GuestInfo.Address
                : currentReviewGuest.Address;

            currentReviewGuest.City = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.City)
                ? currentOcrReview.GuestInfo.City
                : currentReviewGuest.City;

            currentReviewGuest.State = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.State)
                ? currentOcrReview.GuestInfo.State
                : currentReviewGuest.State;

            currentReviewGuest.Country = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.Country)
                ? currentOcrReview.GuestInfo.Country
                : currentReviewGuest.Country;

            currentReviewGuest.MobileNo = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.MobileNo)
                ? currentOcrReview.GuestInfo.MobileNo
                : currentReviewGuest.MobileNo;

            currentReviewGuest.PanOrAadharNo = !string.IsNullOrWhiteSpace(currentOcrReview.GuestInfo.IdNumber)
                ? currentOcrReview.GuestInfo.IdNumber
                : currentReviewGuest.PanOrAadharNo;

            // Show success notification
            ocrSuccessGuests.Add(currentReviewGuest.Id);

            // Hide the modal
            HideOcrReviewModal();
            StateHasChanged();
        }
    }


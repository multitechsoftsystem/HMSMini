                            <!-- Summary -->
                            <div class="card mb-4">
                                <div class="card-body">
                                    <h5 class="mb-3">Bill Summary</h5>
                                    <div class="row">
                                        <div class="col-md-8 offset-md-4">
                                            <table class="table table-sm">
                                                <tbody>
                                                    <tr>
                                                        <td>Room Charges (@billPreview.TotalNights @(billPreview.TotalNights == 1 ? "night" : "nights"))</td>
                                                        <td class="text-end">₹@billPreview.RoomChargesSubtotal.ToString("N2")</td>
                                                    </tr>
                                                    <tr>
                                                        <td>Meal Charges</td>
                                                        <td class="text-end">₹@billPreview.MealChargesSubtotal.ToString("N2")</td>
                                                    </tr>
                                                    <tr>
                                                        <td>Discount</td>
                                                        <td class="text-end text-success">-₹@billPreview.DiscountAmount.ToString("N2")</td>
                                                    </tr>
                                                    <tr>
                                                        <td>Additional Charges</td>
                                                        <td class="text-end">₹@billPreview.AdditionalChargesSubtotal.ToString("N2")</td>
                                                    </tr>
                                                    <tr class="table-light">
                                                        <td><strong>Subtotal Before Tax</strong></td>
                                                        <td class="text-end"><strong>₹@billPreview.SubtotalBeforeTax.ToString("N2")</strong></td>
                                                    </tr>

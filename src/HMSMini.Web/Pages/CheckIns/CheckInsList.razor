@page "/checkins"
@inject IApiClientService ApiClient
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@using HMSMini.Web.Services
@using HMSMini.Web.Models
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Check-Ins - MSS</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Check-Ins</h2>
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <i class="bi bi-plus-circle"></i> New Check-In
        </button>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Active Check-Ins</h5>
        </div>
        <div class="card-body">
            @if (loading)
            {
                <div class="text-center">
                    <div class="spinner-border"></div>
                </div>
            }
            else if (checkIns.Any())
            {
                <div class="mb-3">
                    <div class="input-group" style="max-width: 500px;">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search by room, guest name, company, or GST number..."
                               @bind="checkInSearchFilter"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(checkInSearchFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearCheckInSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                    @if (FilteredCheckIns.Any())
                    {
                        <small class="text-muted">Showing @FilteredCheckIns.Count of @checkIns.Count check-ins</small>
                    }
                </div>
                <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-hover">
                        <thead style="position: sticky; top: 0; background-color: white; z-index: 10;">
                            <tr>
                                <th>Room</th>
                                <th>Check-In Date</th>
                                <th>Check-Out Date</th>
                                <th>Guests</th>
                                <th>Company/GST</th>
                                <th>Business Source</th>
                                <th>Meal Plan</th>
                                <th>Guest Type</th>
                                <th>Tariff</th>
                                <th>Meal Plan Amt</th>
                                <th>Total Advance Amt</th>
                                <th>Bill Amt</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var checkIn in FilteredCheckIns)
                            {
                                <tr>
                                    <td>@checkIn.RoomNumber</td>
                                    <td>@checkIn.CheckInDate.ToString("dd/MMM/yyyy")</td>
                                    <td>@checkIn.CheckOutDate.ToString("dd/MMM/yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(checkIn.GuestNames))
                                        {
                                            <strong>@checkIn.GuestNames</strong>
                                            <br />
                                            <small class="text-muted">(@checkIn.Pax guest@(checkIn.Pax > 1 ? "s" : ""))</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@checkIn.Pax guest@(checkIn.Pax > 1 ? "s" : "")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(checkIn.CompanyName))
                                        {
                                            <span>@checkIn.CompanyName</span>
                                            @if (!string.IsNullOrEmpty(checkIn.CompanyGSTNumber))
                                            {
                                                <br />
                                                <small class="text-muted">GST: @checkIn.CompanyGSTNumber</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Walk-in</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(checkIn.BusinessSourceName))
                                        {
                                            <span>@checkIn.BusinessSourceName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(checkIn.MealPlanName))
                                        {
                                            <span>@checkIn.MealPlanName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(checkIn.GuestTypeName))
                                        {
                                            <span>@checkIn.GuestTypeName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    @* Tariff Column *@
                                    <td>
                                        @if (checkIn.TariffApplied.HasValue)
                                        {
                                            <text>₹@checkIn.TariffApplied.Value.ToString("N2")</text>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    @* Meal Plan Amt Column *@
                                    <td>
                                        @if (checkIn.MealPlanRate.HasValue)
                                        {
                                            <text>₹@checkIn.MealPlanRate.Value.ToString("N2")</text>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    @* Total Advance Amt Column *@
                                    <td>
                                        @{
                                            var financialData = GetFinancialData(checkIn.Id);
                                        }
                                        @if (financialData.IsLoading)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        }
                                        else if (financialData.HasError)
                                        {
                                            <span class="text-danger" title="@financialData.ErrorMessage">Error</span>
                                        }
                                        else
                                        {
                                            <text>₹@financialData.TotalAdvanceAmount.ToString("N2")</text>
                                        }
                                    </td>
                                    @* Bill Amt Column *@
                                    <td>
                                        @if (financialData.IsLoading)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        }
                                        else if (financialData.HasError)
                                        {
                                            <span class="text-danger" title="@financialData.ErrorMessage">Error</span>
                                        }
                                        else
                                        {
                                            <text>₹@financialData.BillAmount.ToString("N2")</text>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@(checkIn.Status == 0 ? "success" : "secondary")">
                                            @checkIn.StatusName
                                        </span>
                                    </td>
                                    <td>
                                        @if (checkIn.Status == 0)
                                        {
                                            <button class="btn btn-sm btn-primary me-1" @onclick="() => ShowEditModal(checkIn)">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                            <button class="btn btn-sm btn-info me-1" @onclick="() => ManageGuests(checkIn.Id)">
                                                <i class="bi bi-person-badge"></i> Guests
                                            </button>
                                            <button class="btn btn-sm btn-warning" @onclick="() => CheckOut(checkIn.Id)">
                                                Check Out
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => ViewBill(checkIn.Id)">
                                                <i class="bi bi-printer"></i> View Bill
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No active check-ins</p>
            }
        </div>
    </div>
</div>

<!-- Create Check-In Modal -->
@if (showCreateModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Check-In</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @createErrorMessage
                        </div>
                    }

                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == GuestEntryTab.ManualEntry ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchTab(GuestEntryTab.ManualEntry)">
                                <i class="bi bi-keyboard"></i> Manual Entry
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == GuestEntryTab.OcrScan ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchTab(GuestEntryTab.OcrScan)">
                                <i class="bi bi-card-image"></i> OCR Scan
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == GuestEntryTab.GuestHistory ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchTab(GuestEntryTab.GuestHistory)">
                                <i class="bi bi-search"></i> Guest History
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <EditForm Model="newCheckIn" OnValidSubmit="CreateCheckIn">
                        <DataAnnotationsValidator />

                        <!-- Room Selection (Common across all tabs) -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Room Number <span class="text-danger">*</span></label>
                                <InputSelect @bind-Value="newCheckIn.RoomNumber" class="form-control" @bind-Value:after="OnRoomOrDateChanged">
                                    <option value="">-- Select Room --</option>
                                    @foreach (var room in availableRooms)
                                    {
                                        <option value="@room.RoomNumber">@room.RoomNumber - @room.RoomTypeName</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label>Check-Out Date</label>
                                <InputDate @bind-Value="newCheckIn.CheckOutDate" class="form-control" @bind-Value:after="OnRoomOrDateChanged" />
                            </div>
                        </div>

                        <!-- Company Selection -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label>Company (Optional)</label>
                                <div class="input-group">
                                    <select @bind="selectedCompanyId" class="form-control" @bind:after="OnCompanyChanged">
                                        <option value="">-- Walk-in Guest --</option>
                                        @foreach (var company in activeCompanies)
                                        {
                                            <option value="@company.Id">@company.CompanyName (@company.DiscountPercentage% discount)</option>
                                        }
                                    </select>
                                    @if (canManageCompanies)
                                    {
                                        <button type="button" class="btn btn-outline-primary" @onclick="ShowQuickAddCompanyModal" title="Add New Company">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                    }
                                </div>
                                <small class="text-muted">Leave empty for walk-in guests@(canManageCompanies ? " or click + to add a new company" : "")</small>
                                @if (!string.IsNullOrEmpty(selectedCompanyId))
                                {
                                    var selectedCompany = activeCompanies.FirstOrDefault(c => c.Id.ToString() == selectedCompanyId);
                                    if (selectedCompany != null && !string.IsNullOrEmpty(selectedCompany.GSTNumber))
                                    {
                                        <div class="mt-2">
                                            <strong>GST Number:</strong> <span class="text-primary">@selectedCompany.GSTNumber</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Tariff Calculation Display -->
                        @if (calculatedTariff != null)
                        {
                            <div class="alert alert-info mb-3">
                                <h6><i class="bi bi-calculator"></i> Tariff Details</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Room Type:</strong> @calculatedTariff.RoomTypeName<br />
                                        <strong>Occupancy:</strong> @calculatedTariff.OccupancyCount person(s)<br />
                                        <strong>Nights:</strong> @calculatedTariff.NumberOfNights
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Base Rate:</strong> <text>Rs. </text>@calculatedTariff.BaseRate<text> per night</text><br />
                                        @if (calculatedTariff.CompanyRate.HasValue)
                                        {
                                            <strong>Company Rate:</strong> <text>Rs. </text>@calculatedTariff.CompanyRate<text> per night</text><br />
                                        }
                                        @if (calculatedTariff.DiscountPercentage > 0)
                                        {
                                            <strong>Discount:</strong> @calculatedTariff.DiscountPercentage<text>%</text><br />
                                        }
                                        <strong>Final Rate:</strong> <text>Rs. </text>@calculatedTariff.FinalRate<text> per night</text>
                                    </div>
                                </div>
                                <hr />
                                <h5 class="text-primary mb-0">Total Amount: Rs. @calculatedTariff.TotalAmount</h5>
                            </div>
                        }

                        <!-- Tab 1: Manual Entry -->
                        @if (activeTab == GuestEntryTab.ManualEntry)
                        {
                            <div class="tab-content-manual">
                                <h6 class="mb-3">Guest Information (Manual Entry)</h6>
                                @for (int i = 0; i < newCheckIn.Guests.Count; i++)
                                {
                                    var index = i;
                                    <div class="border rounded p-3 mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong>Guest @(index + 1)</strong>
                                            @if (newCheckIn.Guests.Count > 1)
                                            {
                                                <button type="button" class="btn btn-sm btn-danger"
                                                        @onclick="() => RemoveGuest(index)">Remove</button>
                                            }
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <label>Name <span class="text-danger">*</span></label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].GuestName" class="form-control" placeholder="Required" />
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <label>Mobile (10 digits)</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].MobileNo" class="form-control" placeholder="e.g., 9876543210" maxlength="10" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>Address</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].Address" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4 mb-2">
                                                <label>City</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].City" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>State</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].State" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>Country</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].Country" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>PAN/Aadhar No</label>
                                                <InputText @bind-Value="newCheckIn.Guests[index].PanOrAadharNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (newCheckIn.Guests.Count < 3)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm mb-3" @onclick="AddGuest">
                                        <i class="bi bi-plus"></i> Add Guest
                                    </button>
                                }
                            </div>
                        }

                        <!-- Tab 2: OCR Scan -->
                        @if (activeTab == GuestEntryTab.OcrScan)
                        {
                            <div class="tab-content-ocr">
                                <h6 class="mb-3">Scan ID Proof</h6>
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> Upload an ID proof image to automatically extract guest details
                                </div>

                                <div class="border rounded p-3 mb-3">
                                    <label class="form-label">Upload ID Proof Image</label>
                                    <InputFile OnChange="HandleOcrFileUpload"
                                               accept="image/*"
                                               class="form-control mb-2" />
                                    @if (!string.IsNullOrEmpty(ocrFileName))
                                    {
                                        <div class="alert alert-success py-1 px-2">
                                            <small><i class="bi bi-file-earmark"></i> Selected: @ocrFileName</small>
                                        </div>
                                    }

                                    @if (processingOcr)
                                    {
                                        <div class="alert alert-info">
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            Processing OCR...
                                        </div>
                                    }

                                    @if (ocrFile != null && !processingOcr && createOcrResult == null)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="ProcessCreateOcr">
                                            <i class="bi bi-cpu"></i> Extract Information
                                        </button>
                                    }
                                </div>

                                <!-- Show extracted data and editable form if OCR processed -->
                                @if (createOcrResult != null && newCheckIn.Guests.Any())
                                {
                                    <div class="alert alert-success">
                                        <i class="bi bi-check-circle"></i> Information extracted! Review and edit below.
                                        <small class="d-block mt-1">Confidence: @((createOcrResult.Confidence * 100).ToString("F1"))%</small>
                                    </div>

                                    <h6 class="mt-3">Guest Information (From OCR)</h6>
                                    <div class="border rounded p-3 mb-3">
                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <label>Name <span class="text-danger">*</span></label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].GuestName" class="form-control" placeholder="Required" />
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <label>Mobile (10 digits)</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].MobileNo" class="form-control" placeholder="e.g., 9876543210" maxlength="10" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>Address</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].Address" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4 mb-2">
                                                <label>City</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].City" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>State</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].State" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>Country</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].Country" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>PAN/Aadhar No</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].PanOrAadharNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Tab 3: Guest History Search -->
                        @if (activeTab == GuestEntryTab.GuestHistory)
                        {
                            <div class="tab-content-history">
                                <h6 class="mb-3">Search Guest History</h6>

                                <div class="input-group mb-3">
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Search by mobile number or guest name..."
                                           @bind="searchQuery"
                                           @bind:event="oninput"
                                           @onkeypress="HandleSearchKeyPress" />
                                    <button class="btn btn-primary" type="button" @onclick="SearchGuests">
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                </div>

                                @if (searching)
                                {
                                    <div class="text-center my-3">
                                        <div class="spinner-border spinner-border-sm"></div>
                                        <span class="ms-2">Searching...</span>
                                    </div>
                                }

                                @if (searchResults.Any())
                                {
                                    <div class="border rounded p-3 bg-light mb-3" style="max-height: 300px; overflow-y: auto;">
                                        <h6 class="mb-2">Search Results (@searchResults.Count found)</h6>
                                        @foreach (var guest in searchResults)
                                        {
                                            <div class="card mb-2">
                                                <div class="card-body py-2">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <strong>@guest.GuestName</strong>
                                                            @if (!string.IsNullOrEmpty(guest.MobileNo))
                                                            {
                                                                <span class="text-muted ms-2">
                                                                    <i class="bi bi-phone"></i> @guest.MobileNo
                                                                </span>
                                                            }
                                                            <div class="text-muted small">
                                                                @if (!string.IsNullOrEmpty(guest.City) || !string.IsNullOrEmpty(guest.State) || !string.IsNullOrEmpty(guest.Country))
                                                                {
                                                                    <span>@guest.City@(!string.IsNullOrEmpty(guest.City) && (!string.IsNullOrEmpty(guest.State) || !string.IsNullOrEmpty(guest.Country)) ? ", " : "")@guest.State@(!string.IsNullOrEmpty(guest.State) && !string.IsNullOrEmpty(guest.Country) ? ", " : "")@guest.Country</span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <button type="button"
                                                                class="btn btn-sm btn-success"
                                                                @onclick="() => UseGuestHistory(guest)">
                                                            <i class="bi bi-arrow-right-circle"></i> Use This
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!searching && !string.IsNullOrEmpty(searchQuery) && searchQuery.Length >= 3)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-info-circle"></i> No guests found matching "@searchQuery"
                                    </div>
                                }

                                <!-- Show guest form after selecting from history -->
                                @if (newCheckIn.Guests.Any() && !string.IsNullOrEmpty(newCheckIn.Guests[0].GuestName))
                                {
                                    <div class="alert alert-info">
                                        <i class="bi bi-check-circle"></i> Guest information loaded from history. Review and edit below.
                                    </div>

                                    <h6 class="mt-3">Guest Information (From History)</h6>
                                    <div class="border rounded p-3 mb-3">
                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <label>Name <span class="text-danger">*</span></label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].GuestName" class="form-control" placeholder="Required" />
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <label>Mobile (10 digits)</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].MobileNo" class="form-control" placeholder="e.g., 9876543210" maxlength="10" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>Address</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].Address" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4 mb-2">
                                                <label>City</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].City" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>State</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].State" class="form-control" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label>Country</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].Country" class="form-control" />
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-2">
                                                <label>PAN/Aadhar No</label>
                                                <InputText @bind-Value="newCheckIn.Guests[0].PanOrAadharNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Business Source and Meal Plan Selection -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Business Source</label>
                                <select @bind="selectedBusinessSourceId" class="form-control">
                                    <option value="">-- Select Business Source --</option>
                                    @foreach (var source in businessSources)
                                    {
                                        <option value="@source.BusinessSourceId">@source.SourceName</option>
                                    }
                                </select>
                                <small class="text-muted">Track where this booking came from</small>
                            </div>
                            <div class="col-md-6">
                                <label>Meal Plan</label>
                                <select @bind="selectedMealPlanId" class="form-control" @bind:after="OnMealPlanChanged">
                                    <option value="">-- Select Meal Plan --</option>
                                    @foreach (var plan in mealPlans)
                                    {
                                        <option value="@plan.MealPlanId">@plan.PlanCode - @plan.PlanName</option>
                                    }
                                </select>
                                <small class="text-muted">Select meal plan for tariff calculation</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <label>Guest Type</label>
                                <select @bind="selectedGuestTypeId" class="form-control">
                                    <option value="">-- Select Guest Type --</option>
                                    @foreach (var guestType in guestTypes)
                                    {
                                        <option value="@guestType.GuestTypeId">@guestType.TypeName</option>
                                    }
                                </select>
                                <small class="text-muted">Classify guest type (Normal, Complimentary, etc.)</small>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="HideCreateModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@(!HasGuestData())">
                                Create Check-In
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Manage Guests Modal -->
@if (showGuestsModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Guests - Room @selectedCheckIn?.RoomNumber</h5>
                    <button type="button" class="btn-close" @onclick="HideGuestsModal"></button>
                </div>
                <div class="modal-body">
                    @if (loadingGuests)
                    {
                        <div class="text-center">
                            <div class="spinner-border"></div>
                        </div>
                    }
                    else if (managedGuests.Any())
                    {
                        <!-- All Guests - Guest 1 first, then others by guest number -->
                        @foreach (var guest in managedGuests.OrderBy(g => g.GuestNumber))
                        {
                            <div class="card mb-3 @(guest.Status == 1 ? "border-secondary" : "")">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Guest @guest.GuestNumber: @guest.GuestName</strong>
                                        @if (guest.Status == 0)
                                        {
                                            <span class="badge bg-success ms-2">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary ms-2">Checked Out</span>
                                        }
                                    </div>
                                    @if (guest.Status == 0 && guest.GuestNumber > 1)
                                    {
                                        <button class="btn btn-sm btn-warning" @onclick="() => CheckOutGuest(guest.Id)">
                                            <i class="bi bi-box-arrow-right"></i> Check Out Guest
                                        </button>
                                    }
                                </div>
                                <div class="card-body">
                                    <!-- Status Information -->
                                    <div class="alert alert-info py-2 mb-3">
                                        <small>
                                            @if (guest.ActualCheckInDate.HasValue)
                                            {
                                                <strong>Checked In:</strong> @guest.ActualCheckInDate.Value.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt")
                                            }
                                            @if (guest.ActualCheckOutDate.HasValue)
                                            {
                                                <span class="ms-3"><strong>Checked Out:</strong> @guest.ActualCheckOutDate.Value.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt")</span>
                                            }
                                        </small>
                                    </div>

                                    <div class="row">
                                        <!-- Guest Information -->
                                        <div class="col-md-6">
                                            <h6>Guest Information</h6>
                                            <div class="mb-2">
                                                <label class="form-label">Name</label>
                                                <InputText @bind-Value="guest.GuestName" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Address</label>
                                                <InputText @bind-Value="guest.Address" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">City</label>
                                                <InputText @bind-Value="guest.City" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">State</label>
                                                <InputText @bind-Value="guest.State" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Country</label>
                                                <InputText @bind-Value="guest.Country" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Mobile</label>
                                                <InputText @bind-Value="guest.MobileNo" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">PAN/Aadhar No</label>
                                                <InputText @bind-Value="guest.PanOrAadharNo" class="form-control form-control-sm" disabled="@(guest.Status == 1)" />
                                            </div>
                                            @if (guest.Status == 0)
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick="() => UpdateGuest(guest)">
                                                    <i class="bi bi-save"></i> Save Changes
                                                </button>
                                            }
                                        </div>

                                        <!-- ID Proof Upload and OCR -->
                                        <div class="col-md-6">
                                            <h6>ID Proof Documents</h6>

                                            @if (guest.Status == 0)
                                            {
                                                <!-- Photo 1 - Active Guest -->
                                                <div class="border rounded p-2 mb-2">
                                                    <strong>Photo 1:</strong>
                                                    @if (!string.IsNullOrEmpty(guest.Photo1Path))
                                                    {
                                                        <span class="badge bg-success ms-2">Uploaded</span>
                                                    }
                                                    <div class="mt-2">
                                                        <InputFile OnChange="@(e => HandlePhotoUpload(e, guest.Id, 1))"
                                                                   accept="image/*"
                                                                   class="form-control form-control-sm mb-2" />
                                                        @{
                                                            var photo1Key = $"{guest.Id}_photo1";
                                                            if (selectedFileNames.ContainsKey(photo1Key))
                                                            {
                                                                <div class="alert alert-info py-1 px-2 mb-2">
                                                                    <small><i class="bi bi-file-earmark"></i> Selected: @selectedFileNames[photo1Key]</small>
                                                                </div>
                                                            }
                                                        }
                                                        @if (!string.IsNullOrEmpty(guest.Photo1Path))
                                                        {
                                                            <div class="mb-2">
                                                                <img src="@GetPhotoUrl(guest.Id, 1)"
                                                                     alt="Photo 1"
                                                                     class="img-thumbnail"
                                                                     style="max-width: 200px; max-height: 150px; object-fit: contain;" />
                                                            </div>
                                                            <button class="btn btn-sm btn-success" @onclick="() => ProcessOcr(guest, 1)">
                                                                <i class="bi bi-cpu"></i> Process OCR
                                                            </button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Photo 2 - Active Guest -->
                                                <div class="border rounded p-2 mb-2">
                                                    <strong>Photo 2:</strong>
                                                    @if (!string.IsNullOrEmpty(guest.Photo2Path))
                                                    {
                                                        <span class="badge bg-success ms-2">Uploaded</span>
                                                    }
                                                    <div class="mt-2">
                                                        <InputFile OnChange="@(e => HandlePhotoUpload(e, guest.Id, 2))"
                                                                   accept="image/*"
                                                                   class="form-control form-control-sm mb-2" />
                                                        @{
                                                            var photo2Key = $"{guest.Id}_photo2";
                                                            if (selectedFileNames.ContainsKey(photo2Key))
                                                            {
                                                                <div class="alert alert-info py-1 px-2 mb-2">
                                                                    <small><i class="bi bi-file-earmark"></i> Selected: @selectedFileNames[photo2Key]</small>
                                                                </div>
                                                            }
                                                        }
                                                        @if (!string.IsNullOrEmpty(guest.Photo2Path))
                                                        {
                                                            <div class="mb-2">
                                                                <img src="@GetPhotoUrl(guest.Id, 2)"
                                                                     alt="Photo 2"
                                                                     class="img-thumbnail"
                                                                     style="max-width: 200px; max-height: 150px; object-fit: contain;" />
                                                            </div>
                                                            <button class="btn btn-sm btn-success" @onclick="() => ProcessOcr(guest, 2)">
                                                                <i class="bi bi-cpu"></i> Process OCR
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Checked-out Guest - View Only -->
                                                @if (!string.IsNullOrEmpty(guest.Photo1Path))
                                                {
                                                    <div class="border rounded p-2 mb-2">
                                                        <strong>Photo 1:</strong>
                                                        <div class="mt-2">
                                                            <img src="@GetPhotoUrl(guest.Id, 1)"
                                                                 alt="Photo 1"
                                                                 class="img-thumbnail"
                                                                 style="max-width: 200px; max-height: 150px; object-fit: contain;" />
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(guest.Photo2Path))
                                                {
                                                    <div class="border rounded p-2 mb-2">
                                                        <strong>Photo 2:</strong>
                                                        <div class="mt-2">
                                                            <img src="@GetPhotoUrl(guest.Id, 2)"
                                                                 alt="Photo 2"
                                                                 class="img-thumbnail"
                                                                 style="max-width: 200px; max-height: 150px; object-fit: contain;" />
                                                        </div>
                                                    </div>
                                                }
                                            }

                                            @if (uploadingGuests.Contains(guest.Id))
                                            {
                                                <div class="alert alert-info">
                                                    <i class="bi bi-upload"></i> Uploading...
                                                </div>
                                            }

                                            @if (processingOcrGuests.Contains(guest.Id))
                                            {
                                                <div class="alert alert-info">
                                                    <i class="bi bi-cpu"></i> Processing OCR...
                                                </div>
                                            }

                                            @if (ocrSuccessGuests.Contains(guest.Id))
                                            {
                                                <div class="alert alert-success">
                                                    <i class="bi bi-check-circle"></i> OCR completed! Information auto-filled above.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Add New Guest Section -->
                        <div class="card mb-3 border-success">
                            <div class="card-header bg-light">
                                <strong><i class="bi bi-plus-circle"></i> Add New Guest</strong>
                            </div>
                            <div class="card-body">
                                <EditForm Model="newGuest" OnValidSubmit="AddNewGuest">
                                    <div class="row">
                                        <!-- Guest Information -->
                                        <div class="col-md-6">
                                            <h6>Guest Information</h6>
                                            <div class="mb-2">
                                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                                <InputText @bind-Value="newGuest.GuestName" class="form-control form-control-sm" placeholder="Required" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Address</label>
                                                <InputText @bind-Value="newGuest.Address" class="form-control form-control-sm" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">City</label>
                                                <InputText @bind-Value="newGuest.City" class="form-control form-control-sm" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">State</label>
                                                <InputText @bind-Value="newGuest.State" class="form-control form-control-sm" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Country</label>
                                                <InputText @bind-Value="newGuest.Country" class="form-control form-control-sm" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Mobile (10 digits)</label>
                                                <InputText @bind-Value="newGuest.MobileNo" class="form-control form-control-sm" placeholder="e.g., 9876543210" maxlength="10" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">PAN/Aadhar No</label>
                                                <InputText @bind-Value="newGuest.PanOrAadharNo" class="form-control form-control-sm" />
                                            </div>
                                        </div>

                                        <!-- ID Proof Upload -->
                                        <div class="col-md-6">
                                            <h6>ID Proof Documents (Optional)</h6>

                                            <!-- Photo 1 -->
                                            <div class="border rounded p-2 mb-2">
                                                <strong>Photo 1:</strong>
                                                <div class="mt-2">
                                                    <InputFile OnChange="@HandleNewGuestPhoto1Change"
                                                               accept="image/*"
                                                               class="form-control form-control-sm mb-2" />
                                                    @if (!string.IsNullOrEmpty(newGuestPhoto1Name))
                                                    {
                                                        <div class="alert alert-info py-1 px-2 mb-2">
                                                            <small><i class="bi bi-file-earmark"></i> Selected: @newGuestPhoto1Name</small>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Photo 2 -->
                                            <div class="border rounded p-2 mb-2">
                                                <strong>Photo 2:</strong>
                                                <div class="mt-2">
                                                    <InputFile OnChange="@HandleNewGuestPhoto2Change"
                                                               accept="image/*"
                                                               class="form-control form-control-sm mb-2" />
                                                    @if (!string.IsNullOrEmpty(newGuestPhoto2Name))
                                                    {
                                                        <div class="alert alert-info py-1 px-2 mb-2">
                                                            <small><i class="bi bi-file-earmark"></i> Selected: @newGuestPhoto2Name</small>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="alert alert-warning py-1 px-2">
                                                <small><i class="bi bi-info-circle"></i> Photos will be uploaded after guest is created</small>
                                            </div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(addGuestError))
                                    {
                                        <div class="alert alert-danger alert-sm py-1 px-2 mt-2">
                                            <small>@addGuestError</small>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(addGuestSuccess))
                                    {
                                        <div class="alert alert-success alert-sm py-1 px-2 mt-2">
                                            <small>@addGuestSuccess</small>
                                        </div>
                                    }
                                    <div class="mt-3">
                                        <button type="submit" class="btn btn-success btn-sm" disabled="@addingGuest">
                                            @if (addingGuest)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-plus-circle"></i> Add Guest
                                        </button>
                                    </div>
                                </EditForm>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideGuestsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Check-In Modal -->
@if (showEditModal && selectedCheckInForEdit != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Check-In - Room @selectedCheckInForEdit.RoomNumber</h5>
                    <button type="button" class="btn-close" @onclick="HideEditModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(editErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @editErrorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <p><strong>Room:</strong> @selectedCheckInForEdit.RoomNumber</p>
                        <p><strong>Guest(s):</strong> @selectedCheckInForEdit.GuestNames</p>
                        <p><strong>Dates:</strong> @selectedCheckInForEdit.CheckInDate.ToShortDateString() - @selectedCheckInForEdit.CheckOutDate.ToShortDateString()</p>
                    </div>

                    <div class="mb-3">
                        <label>Company</label>
                        <select class="form-control" @bind="editCheckInModel.CompanyId">
                            <option value="">-- No Company --</option>
                            @foreach (var company in editCompanies)
                            {
                                <option value="@company.Id">@company.CompanyName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Business Source</label>
                        <select class="form-control" @bind="editCheckInModel.BusinessSourceId">
                            <option value="">-- No Business Source --</option>
                            @foreach (var source in editBusinessSources)
                            {
                                <option value="@source.BusinessSourceId">@source.SourceName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Meal Plan</label>
                        <select class="form-control" @bind="editCheckInModel.MealPlanId">
                            <option value="">-- No Meal Plan --</option>
                            @foreach (var plan in editMealPlans)
                            {
                                <option value="@plan.MealPlanId">@plan.PlanCode - @plan.PlanName</option>
                            }
                        </select>
                        <small class="text-muted">Changing meal plan will recalculate charges</small>
                    </div>

                    <div class="mb-3">
                        <label>Guest Type</label>
                        <select class="form-control" @bind="editCheckInModel.GuestTypeId">
                            <option value="">-- No Guest Type --</option>
                            @foreach (var guestType in editGuestTypes)
                            {
                                <option value="@guestType.GuestTypeId">@guestType.TypeName</option>
                            }
                        </select>
                        <small class="text-muted">Classify guest type (Normal, Complimentary, etc.)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideEditModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UpdateCheckIn">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bill Preview Modal (New - with day-by-day breakdown) -->
@if (showBillPreviewModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header no-print">
                    <h5 class="modal-title">Bill Preview - Room @(billPreview?.RoomNumber ?? "N/A")</h5>
                    <button type="button" class="btn-close" @onclick="HideBillPreviewModal"></button>
                </div>
                <div class="modal-body">
                    @if (loadingBillPreview)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading bill...</span>
                            </div>
                            <p class="mt-2">Calculating charges...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(billErrorMessage))
                    {
                        <div class="alert alert-danger">@billErrorMessage</div>
                    }
                    else if (billPreview != null)
                    {
                        <div id="printable-bill-preview">
                            <!-- Hotel Header -->
                            <div class="text-center mb-4">
                                <h3>Hotel Management System</h3>
                                <p class="text-muted">Guest Bill Preview</p>
                            </div>

                            <!-- Guest Information -->
                            <div class="card mb-4">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <p><strong>Room Number:</strong> @billPreview.RoomNumber</p>
                                            <p><strong>Guest Names:</strong> @billPreview.GuestNames</p>
                                        </div>
                                        <div class="col-md-4">
                                            <p><strong>Check-In:</strong> @billPreview.ActualCheckInDate.ToString("dd/MMM/yyyy")</p>
                                            <p><strong>Check-Out:</strong> @billPreview.ProposedCheckOutDate.ToString("dd/MMM/yyyy")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <p><strong>Total Nights:</strong> @billPreview.TotalNights</p>
                                            <p><strong>Occupancy:</strong> @billPreview.Pax @(billPreview.Pax == 1 ? "Guest" : "Guests")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Day-Wise Charges -->
                            <h5 class="mb-3">Day-Wise Charges</h5>
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th class="text-end">Room Rate</th>
                                            <th class="text-end">Meal Rate</th>
                                            <th class="text-end">Subtotal</th>
                                            <th class="text-end">Discount</th>
                                            <th class="text-end">After Discount</th>
                                            <th class="text-end">Tax</th>
                                            <th class="text-end">Day Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in billPreview.DailyCharges)
                                        {
                                            <tr>
                                                <td>
                                                    @day.Date.ToString("dd/MMM/yyyy")
                                                    @if (!string.IsNullOrEmpty(day.RateChangeNote))
                                                    {
                                                        <br /><small class="text-info">@day.RateChangeNote</small>
                                                    }
                                                </td>
                                                <td class="text-end">₹@day.RoomRate.ToString("N2")</td>
                                                <td class="text-end">₹@day.MealPlanRate.ToString("N2")</td>
                                                <td class="text-end">₹@day.SubtotalBeforeDiscount.ToString("N2")</td>
                                                <td class="text-end">-₹@day.DiscountAmount.ToString("N2")</td>
                                                <td class="text-end">₹@((day.SubtotalBeforeDiscount - day.DiscountAmount).ToString("N2"))</td>
                                                <td class="text-end">₹@day.TotalTax.ToString("N2")</td>
                                                <td class="text-end"><strong>₹@day.DayTotal.ToString("N2")</strong></td>
                                            </tr>
                                        }
                                        <tr class="table-light">
                                            <td colspan="7" class="text-end"><strong>Total Room & Meal Charges:</strong></td>
                                            <td class="text-end"><strong>₹@billPreview.DailyCharges.Sum(d => d.DayTotal).ToString("N2")</strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Additional Charges -->
                            <h5 class="mb-3">Additional Charges
                                @if (!showAddChargeForm)
                                {
                                    <button class="btn btn-sm btn-success ms-2 no-print" @onclick="ShowAddChargeForm">
                                        <i class="bi bi-plus-circle"></i> Add Charge
                                    </button>
                                }
                            </h5>

                            @if (showAddChargeForm)
                            {
                                <div class="card mb-3 no-print">
                                    <div class="card-body">
                                        <h6>New Charge</h6>
                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <label class="form-label">Date</label>
                                                <input type="date" class="form-control" @bind="newCharge.ChargeDate" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Type</label>
                                                <select class="form-select" @bind="newCharge.ChargeType">
                                                    <option value="">Select...</option>
                                                    <option value="Room Service">Room Service</option>
                                                    <option value="Minibar">Minibar</option>
                                                    <option value="Laundry">Laundry</option>
                                                    <option value="Phone">Phone</option>
                                                    <option value="Restaurant">Restaurant</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Description</label>
                                                <input type="text" class="form-control" @bind="newCharge.Description" placeholder="Enter description" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Amount</label>
                                                <input type="number" step="0.01" class="form-control" @bind="newCharge.Amount" />
                                            </div>

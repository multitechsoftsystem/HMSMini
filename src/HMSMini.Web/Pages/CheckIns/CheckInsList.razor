@code {
    private List<CheckInDto> checkIns = new();
    private CreateCheckInDto newCheckIn = new();
    private List<RoomDto> availableRooms = new();
    private bool loading = true;
    private bool showCreateModal = false;
    private string createErrorMessage = string.Empty;
    private Dictionary<int, CheckInFinancialData> financialDataCache = new();
    private string checkInSearchFilter = string.Empty;

    // Company and Tariff
    private List<CompanyDto> activeCompanies = new();
    private string selectedCompanyId = "";
    private TariffCalculationDto? calculatedTariff = null;

    // Quick Add Company
    private bool showQuickAddCompanyModal = false;
    private CreateCompanyDto newCompany = new();
    private bool savingCompany = false;
    private string quickAddCompanyError = string.Empty;

    // Business Source, Meal Plan, and Guest Type
    private List<BusinessSourceModel> businessSources = new();
    private List<MealPlanModel> mealPlans = new();
    private List<GuestTypeModel> guestTypes = new();
    private string selectedBusinessSourceId = "";
    private string selectedMealPlanId = "";
    private string selectedGuestTypeId = "";

    // Guest management
    private bool showGuestsModal = false;
    private bool loadingGuests = false;
    private CheckInDto? selectedCheckIn = null;
    private List<GuestDto> managedGuests = new();
    private HashSet<int> uploadingGuests = new();
    private HashSet<int> processingOcrGuests = new();
    private HashSet<int> ocrSuccessGuests = new();

    // Add guest to existing check-in
    private CreateGuestDto newGuest = new();
    private bool addingGuest = false;
    private string addGuestError = string.Empty;
    private string addGuestSuccess = string.Empty;
    private IBrowserFile? newGuestPhoto1 = null;
    private IBrowserFile? newGuestPhoto2 = null;
    private string newGuestPhoto1Name = string.Empty;
    private string newGuestPhoto2Name = string.Empty;

    // OCR Review Modal
    private bool showOcrReviewModal = false;
    private OcrReviewDto? currentOcrReview = null;
    private GuestDto? currentReviewGuest = null;
    private int currentReviewPhotoNumber = 0;

    // Bill View Modal (legacy - for checked-out check-ins)
    private bool showBillModal = false;
    private CheckInDto? billCheckIn = null;
    private List<GuestDto> billGuests = new();

    // Bill Preview Modal (new - with day-by-day breakdown)
    private bool showBillPreviewModal = false;
    private BillPreviewModel? billPreview = null;
    private bool loadingBillPreview = false;
    private string billErrorMessage = string.Empty;
    private bool showAddChargeForm = false;
    private CreateAdditionalChargeModel newCharge = new();
    private bool addingCharge = false;
    private HashSet<int> deletingCharges = new();

    // Edit Check-In Modal
    private bool showEditModal = false;
    private CheckInDto? selectedCheckInForEdit = null;
    private UpdateCheckInModel editCheckInModel = new();
    private List<CompanyDto> editCompanies = new();
    private List<BusinessSourceModel> editBusinessSources = new();
    private List<MealPlanModel> editMealPlans = new();
    private List<GuestTypeModel> editGuestTypes = new();
    private string editErrorMessage = "";

    // Track selected file names for display
    private Dictionary<string, string> selectedFileNames = new();

    // Tab management for create check-in modal
    private enum GuestEntryTab
    {
        ManualEntry,
        OcrScan,
        GuestHistory
    }

    private GuestEntryTab activeTab = GuestEntryTab.ManualEntry;

    // Guest search
    private string searchQuery = string.Empty;
    private List<GuestDto> searchResults = new();
    private bool searching = false;

    // OCR during creation
    private IBrowserFile? ocrFile = null;
    private string ocrFileName = string.Empty;
    private bool processingOcr = false;
    private OcrReviewDto? createOcrResult = null;

    // Role-based permissions
    private bool canManageCompanies = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserPermissions();
        await LoadCheckIns();
    }

    private async Task CheckUserPermissions()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            // Only Admin (0) and Manager (1) can manage companies
            canManageCompanies = currentUser.Role == 0 || currentUser.Role == 1;
        }
    }

    private async Task LoadCheckIns()
    {
        loading = true;
        checkIns = await ApiClient.GetActiveCheckInsAsync();
        loading = false;

        // Clear cache and load financial data
        financialDataCache.Clear();
        _ = LoadFinancialDataForAllCheckIns(); // Fire and forget
    }

    private List<CheckInDto> FilteredCheckIns
    {
        get
        {
            if (string.IsNullOrWhiteSpace(checkInSearchFilter))
                return checkIns;

            var filter = checkInSearchFilter.ToLower();
            return checkIns.Where(c =>
                c.RoomNumber.ToLower().Contains(filter) ||
                c.GuestNames.ToLower().Contains(filter) ||
                (c.CompanyName?.ToLower().Contains(filter) ?? false) ||
                (c.CompanyGSTNumber?.ToLower().Contains(filter) ?? false) ||
                (c.BusinessSourceName?.ToLower().Contains(filter) ?? false) ||
                (c.MealPlanName?.ToLower().Contains(filter) ?? false) ||
                (c.GuestTypeName?.ToLower().Contains(filter) ?? false)
            ).ToList();
        }
    }

    private void ClearCheckInSearch()
    {
        checkInSearchFilter = string.Empty;
    }

    private CheckInFinancialData GetFinancialData(int checkInId)
    {
        if (!financialDataCache.ContainsKey(checkInId))
        {
            financialDataCache[checkInId] = new CheckInFinancialData
            {
                CheckInId = checkInId,
                IsLoading = true
            };
        }
        return financialDataCache[checkInId];
    }

    private async Task LoadFinancialDataForAllCheckIns()
    {
        var tasks = checkIns.Select(ci => LoadFinancialDataForCheckIn(ci.Id)).ToList();

        foreach (var task in tasks)
        {
            await task;
            StateHasChanged(); // Update UI as each completes
        }
    }

    private async Task LoadFinancialDataForCheckIn(int checkInId)
    {
        var financialData = GetFinancialData(checkInId);

        try
        {
            // Fetch vouchers and bill preview concurrently
            var vouchersTask = ApiClient.GetVouchersByCheckInIdAsync(checkInId);
            var billPreviewTask = ApiClient.GetBillPreviewAsync(checkInId);

            await Task.WhenAll(vouchersTask, billPreviewTask);

            var vouchers = await vouchersTask;
            var billPreview = await billPreviewTask;

            // Calculate total advance (sum of Payment vouchers, excluding cancelled)
            financialData.TotalAdvanceAmount = vouchers
                .Where(v => v.VoucherType == "Payment" && v.PostingStatus != "Cancelled")
                .Sum(v => v.Amount);

            // Get bill amount (grand total including tax)
            financialData.BillAmount = billPreview?.GrandTotal ?? 0;

            financialData.IsLoading = false;
            financialData.HasError = false;
        }
        catch (Exception ex)
        {
            financialData.IsLoading = false;
            financialData.HasError = true;
            financialData.ErrorMessage = "Failed to load financial data";
            Console.WriteLine($"Error loading financial data for check-in {checkInId}: {ex.Message}");
        }
    }

    private async Task ShowCreateModal()
    {
        // Load available rooms
        var allRooms = await ApiClient.GetRoomsAsync();
        availableRooms = allRooms.Where(r => r.RoomStatus == 0).ToList(); // Only available rooms

        // Load active companies
        activeCompanies = await ApiClient.GetActiveCompaniesAsync();

        // Load business sources, meal plans, and guest types
        businessSources = await ApiClient.GetActiveBusinessSourcesAsync();
        mealPlans = await ApiClient.GetActiveMealPlansAsync();
        guestTypes = await ApiClient.GetActiveGuestTypesAsync();

        newCheckIn = new CreateCheckInDto
        {
            CheckInDate = DateTime.Today,
            CheckOutDate = DateTime.Today.AddDays(2),
            Guests = new List<CreateGuestDto> { new CreateGuestDto() }
        };
        createErrorMessage = string.Empty;

        // Reset company and tariff
        selectedCompanyId = "";
        selectedBusinessSourceId = "";
        selectedMealPlanId = "";
        selectedGuestTypeId = "";
        calculatedTariff = null;

        // Reset tab state
        activeTab = GuestEntryTab.ManualEntry;
        searchQuery = string.Empty;

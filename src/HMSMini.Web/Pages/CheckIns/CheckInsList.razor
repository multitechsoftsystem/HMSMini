    private async Task CalculateTariff()
    {
        calculatedTariff = null;

        // Need room, dates, and guests to calculate
        if (string.IsNullOrWhiteSpace(newCheckIn.RoomNumber) ||
            newCheckIn.CheckInDate >= newCheckIn.CheckOutDate ||
            !newCheckIn.Guests.Any())
        {
            return;
        }

        // Get the room to find its room type
        var selectedRoom = availableRooms.FirstOrDefault(r => r.RoomNumber == newCheckIn.RoomNumber);
        if (selectedRoom == null) return;

        // Parse company ID
        int? companyId = null;
        if (!string.IsNullOrWhiteSpace(selectedCompanyId) && int.TryParse(selectedCompanyId, out int parsedCompanyId))
        {
            companyId = parsedCompanyId;
        }

        // Parse meal plan ID
        int? mealPlanId = null;
        if (!string.IsNullOrWhiteSpace(selectedMealPlanId) && int.TryParse(selectedMealPlanId, out int parsedMealPlanId))
        {
            mealPlanId = parsedMealPlanId;
        }

        // Calculate tariff
        try
        {
            calculatedTariff = await ApiClient.CalculateTariffAsync(
                selectedRoom.RoomTypeId,
                newCheckIn.Guests.Count,
                newCheckIn.CheckInDate,
                newCheckIn.CheckOutDate,
                companyId,
                mealPlanId);
        }
        catch
        {
            // Silently fail - tariff calculation is optional
            calculatedTariff = null;
        }
    }


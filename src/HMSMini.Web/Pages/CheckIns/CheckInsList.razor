                                                        <td><h5 class="mb-0">GRAND TOTAL</h5></td>
                                                        <td class="text-end"><h5 class="mb-0">₹@billPreview.GrandTotal.ToString("N2")</h5></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->

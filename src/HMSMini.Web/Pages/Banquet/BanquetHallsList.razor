@page "/banquet/halls"
@inject IApiClientService ApiClient
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation

<PageTitle>Banquet Halls - MSS</PageTitle>

<div class="page-header">
    <h3>Banquet Halls Management</h3>
    @if (canManage)
    {
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <span class="icon">+</span> Add Hall
        </button>
    }
</div>

@if (isLoading)
{
    <div class="loading">Loading banquet halls...</div>
}
else if (halls.Count == 0)
{
    <div class="empty-state">
        <p>No banquet halls found.</p>
        @if (canManage)
        {
            <button class="btn btn-primary" @onclick="ShowCreateModal">Add Banquet Hall</button>
        }
    </div>
}
else
{
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Hall Name</th>
                    <th>Capacity (Min-Max)</th>
                    <th>Rent/Event</th>
                    <th>Location</th>
                    <th>Features</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hall in halls)
                {
                    <tr>
                        <td>@hall.HallName</td>
                        <td>@hall.MinCapacity - @hall.MaxCapacity</td>
                        <td>@hall.RentPerEvent.ToString("N2")</td>
                        <td>@(hall.Location ?? "-")</td>
                        <td>@(hall.Features ?? "-")</td>
                        <td>
                            <span class="status-badge @(hall.IsActive ? "status-active" : "status-inactive")">
                                @(hall.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditModal(hall)">Edit</button>
                                    @if (hall.IsActive)
                                    {
                                        <button class="btn btn-sm btn-warning" @onclick="() => Deactivate(hall.Id)">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => Activate(hall.Id)">Activate</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">View Only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show mt-2">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mt-2">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (showModal)
{
    <div class="modal-overlay" @onclick="HideModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4>@(editingHall == null ? "Add Banquet Hall" : "Edit Banquet Hall")</h4>
                <button class="btn-close" @onclick="HideModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="alert alert-danger">@formError</div>
                }
                <div class="form-group">
                    <label>Hall Name *</label>
                    <input type="text" class="form-control" @bind="formModel.HallName" />
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Min Capacity</label>
                            <input type="number" class="form-control" @bind="formModel.MinCapacity" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Max Capacity *</label>
                            <input type="number" class="form-control" @bind="formModel.MaxCapacity" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Rent Per Event</label>
                    <input type="number" step="0.01" class="form-control" @bind="formModel.RentPerEvent" />
                </div>
                <div class="form-group">
                    <label>Location</label>
                    <input type="text" class="form-control" @bind="formModel.Location" />
                </div>
                <div class="form-group">
                    <label>Features</label>
                    <textarea class="form-control" @bind="formModel.Features" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideModal">Cancel</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<BanquetHallModel> halls = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSaving = false;
    private bool canManage = false;
    private BanquetHallModel? editingHall = null;
    private CreateBanquetHallModel formModel = new();
    private string? errorMessage;
    private string? successMessage;
    private string? formError;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        canManage = user != null && (user.Role == 0 || user.Role == 1 || user.Role == 5);
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        halls = await ApiClient.GetAllBanquetHallsAsync(true);
        isLoading = false;
    }

    private void ShowCreateModal()
    {
        editingHall = null;
        formModel = new CreateBanquetHallModel();
        showModal = true;
    }

    private void ShowEditModal(BanquetHallModel hall)
    {
        editingHall = hall;
        formModel = new CreateBanquetHallModel
        {
            HallName = hall.HallName,
            MaxCapacity = hall.MaxCapacity,
            MinCapacity = hall.MinCapacity,
            RentPerEvent = hall.RentPerEvent,
            Location = hall.Location,
            Features = hall.Features
        };
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
        editingHall = null;
    }

    private async Task Save()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(formModel.HallName))
        {
            formError = "Hall name is required.";
            return;
        }
        if (formModel.MaxCapacity <= 0)
        {
            formError = "Max capacity must be greater than 0.";
            return;
        }
        if (formModel.MinCapacity > formModel.MaxCapacity)
        {
            formError = "Min capacity cannot exceed max capacity.";
            return;
        }
        isSaving = true;
        try
        {
            if (editingHall == null)
            {
                var result = await ApiClient.CreateBanquetHallAsync(formModel);
                if (result == null) { formError = "Failed to create hall."; return; }
                successMessage = "Hall created successfully.";
            }
            else
            {
                var updateModel = new UpdateBanquetHallModel
                {
                    HallName = formModel.HallName,
                    MaxCapacity = formModel.MaxCapacity,
                    MinCapacity = formModel.MinCapacity,
                    RentPerEvent = formModel.RentPerEvent,
                    Location = formModel.Location,
                    Features = formModel.Features
                };
                var result = await ApiClient.UpdateBanquetHallAsync(editingHall.Id, updateModel);
                if (result == null) { formError = "Failed to update hall."; return; }
                successMessage = "Hall updated successfully.";
            }
            await LoadData();
            HideModal();
        }
        catch (Exception ex)
        {
            formError = $"Error: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task Activate(int id)
    {
        errorMessage = null;
        var result = await ApiClient.ActivateBanquetHallAsync(id);
        if (result) { successMessage = "Hall activated."; }
        else { errorMessage = "Failed to activate hall."; }
        await LoadData();
    }

    private async Task Deactivate(int id)
    {
        errorMessage = null;
        var result = await ApiClient.DeactivateBanquetHallAsync(id);
        if (result) { successMessage = "Hall deactivated."; }
        else { errorMessage = "Failed to deactivate hall."; }
        await LoadData();
    }
}

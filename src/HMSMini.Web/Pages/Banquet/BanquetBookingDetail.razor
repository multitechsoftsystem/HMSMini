@page "/banquet/bookings/{BookingId:int}"
@inject IApiClientService ApiClient
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using HMSMini.Web.Utilities

<PageTitle>Booking Detail - MSS</PageTitle>

@if (isLoading)
{
    <div class="loading">Loading booking details...</div>
}
else if (booking == null)
{
    <div class="alert alert-danger">Booking not found.</div>
}
else
{
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back
            </button>
            <strong class="fs-4">Booking #@booking.BookingNumber</strong>
            <span class="badge bg-@GetStatusColor(booking.Status) ms-2 fs-6">@booking.Status</span>
        </div>
        <div class="d-flex gap-2">
            @if (booking.Status == BanquetBookingStatus.Enquiry)
            {
                <button class="btn btn-primary" @onclick="() => ChangeStatus(BanquetBookingStatus.Confirmed)">Confirm</button>
                <button class="btn btn-danger" @onclick="() => ChangeStatus(BanquetBookingStatus.Cancelled)">Cancel</button>
            }
            else if (booking.Status == BanquetBookingStatus.Confirmed)
            {
                <button class="btn btn-warning" @onclick="() => ChangeStatus(BanquetBookingStatus.InProgress)">Start Event</button>
                <button class="btn btn-danger" @onclick="() => ChangeStatus(BanquetBookingStatus.Cancelled)">Cancel</button>
            }
            else if (booking.Status == BanquetBookingStatus.InProgress)
            {
                <button class="btn btn-success" @onclick="() => ChangeStatus(BanquetBookingStatus.Completed)">Complete</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible">@successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Info Card -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5>Booking Information</h5>
                @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowEditModal">Edit</button>
                }
            </div>
            <div class="row mt-2">
                <div class="col-md-3"><strong>Hall:</strong> @booking.HallName</div>
                <div class="col-md-3"><strong>Event:</strong> @booking.EventTypeName</div>
                <div class="col-md-3"><strong>Date:</strong> @booking.EventDate.ToString("MMM dd, yyyy")</div>
                <div class="col-md-3"><strong>Time:</strong> @booking.EventStartTime.ToString(@"hh\:mm") - @booking.EventEndTime.ToString(@"hh\:mm")</div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3"><strong>Expected Guests:</strong> @booking.ExpectedGuests</div>
                <div class="col-md-3"><strong>Actual Guests:</strong> @(booking.ActualGuests?.ToString() ?? "-")</div>
                <div class="col-md-3"><strong>Contact:</strong> @booking.ContactPersonName (@booking.ContactPhone)</div>
                <div class="col-md-3"><strong>Company:</strong> @(booking.CompanyName ?? "-")</div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3"><strong>Pricing:</strong> @booking.PricingType</div>
                <div class="col-md-3"><strong>Hall Rent:</strong> @booking.HallRent.ToString("N2")</div>
                <div class="col-md-3"><strong>Tax:</strong> @(booking.TaxType == TaxType.CgstSgst ? "CGST+SGST" : "IGST")</div>
                <div class="col-md-3"><strong>Discount:</strong> @booking.DiscountPercentage%</div>
            </div>
            @if (!string.IsNullOrEmpty(booking.Remarks))
            {
                <div class="mt-2"><strong>Remarks:</strong> @booking.Remarks</div>
            }
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link @(activeTab == "menus" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("menus"))">Menus (@booking.Menus.Count)</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "services" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("services"))">Services (@booking.Services.Count)</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "charges" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("charges"))">Charges (@booking.Charges.Count)</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "payments" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("payments"))">Payments (@booking.Payments.Count)</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "billing" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("billing"))">Billing</a></li>
    </ul>

    <!-- Menus Tab -->
    @if (activeTab == "menus")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0">Menu Items</h5>
                @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddMenuModal">Add Menu Item</button>
                }
            </div>
            <div class="card-body">
                @if (booking.Menus.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Item Name</th><th>Qty (Plates)</th><th>Rate/Plate</th><th>Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in booking.Menus)
                            {
                                <tr>
                                    <td>@m.MenuDate.ToString("MMM dd")</td>
                                    <td>@(m.ItemName ?? m.PackageName ?? "-")</td>
                                    <td>@m.Quantity</td>
                                    <td>@m.RatePerPlate.ToString("N2")</td>
                                    <td>@m.TotalAmount.ToString("N2")</td>
                                    <td>
                                        @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMenu(m.Id)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted">No menu items added.</p> }
            </div>
        </div>
    }

    <!-- Services Tab -->
    @if (activeTab == "services")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0">Services</h5>
                @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddServiceModal">Add Service</button>
                }
            </div>
            <div class="card-body">
                @if (booking.Services.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Service</th><th>Qty</th><th>Rate</th><th>Total</th><th>Tax</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in booking.Services)
                            {
                                <tr>
                                    <td>@s.ServiceDate.ToString("MMM dd")</td>
                                    <td>@s.ServiceName</td>
                                    <td>@s.Quantity</td>
                                    <td>@s.Rate.ToString("N2")</td>
                                    <td>@s.TotalAmount.ToString("N2")</td>
                                    <td>@(s.ApplyTax ? "Yes" : "No")</td>
                                    <td>
                                        @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteService(s.Id)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted">No services added.</p> }
            </div>
        </div>
    }

    <!-- Charges Tab -->
    @if (activeTab == "charges")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0">Additional Charges</h5>
                @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddChargeModal">Add Charge</button>
                }
            </div>
            <div class="card-body">
                @if (booking.Charges.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th><th>Qty</th><th>Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in booking.Charges)
                            {
                                <tr>
                                    <td>@c.ChargeDate.ToString("MMM dd")</td>
                                    <td>@c.ChargeType</td>
                                    <td>@c.Description</td>
                                    <td>@c.Amount.ToString("N2")</td>
                                    <td>@c.Quantity</td>
                                    <td>@c.TotalAmount.ToString("N2")</td>
                                    <td>
                                        @if (booking.Status != BanquetBookingStatus.Completed && booking.Status != BanquetBookingStatus.Cancelled)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCharge(c.Id)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted">No additional charges.</p> }
            </div>
        </div>
    }

    <!-- Payments Tab -->
    @if (activeTab == "payments")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0">Payments</h5>
                @if (booking.Status != BanquetBookingStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddPaymentModal">Record Payment</button>
                }
            </div>
            <div class="card-body">
                @if (paymentSummary != null)
                {
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Total Charged:</strong> @paymentSummary.TotalCharged.ToString("N2")</div>
                        <div class="col-md-4"><strong>Total Paid:</strong> @paymentSummary.TotalPaid.ToString("N2")</div>
                        <div class="col-md-4"><strong>Balance Due:</strong> <span class="@(paymentSummary.BalanceDue > 0 ? "text-danger" : "text-success")">@paymentSummary.BalanceDue.ToString("N2")</span></div>
                    </div>
                }
                @if (booking.Payments.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Receipt #</th><th>Date</th><th>Type</th><th>Mode</th><th>Amount</th><th>Reference</th></tr></thead>
                        <tbody>
                            @foreach (var p in booking.Payments)
                            {
                                <tr>
                                    <td>@p.ReceiptNumber</td>
                                    <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                    <td>@((PaymentType)p.PaymentType)</td>
                                    <td>@((PaymentMode)p.PaymentMode)</td>
                                    <td>@p.Amount.ToString("N2")</td>
                                    <td>@(p.ReferenceNumber ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted">No payments recorded.</p> }
            </div>
        </div>
    }

    <!-- Billing Tab -->
    @if (activeTab == "billing")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0">Billing</h5>
                <div class="no-print">
                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="PreviewBill" disabled="@billingLoading">Preview Bill</button>
                    @if (invoice == null && booking.Status != BanquetBookingStatus.Cancelled)
                    {
                        <button class="btn btn-sm btn-success me-2" @onclick="FinalizeInvoice" disabled="@billingLoading">Finalize Invoice</button>
                    }
                    @if (invoice != null || billPreview != null)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PrintInvoice"><i class="bi bi-printer"></i> Print</button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (billingLoading)
                {
                    <div class="text-center"><div class="spinner-border spinner-border-sm"></div> Loading...</div>
                }
                else if (invoice != null || billPreview != null)
                {
                    var isFinalized = invoice != null;
                        var isCgstSgst = booking?.TaxType == TaxType.CgstSgst;
                        var sacCode = GetHotelSetting("HotelSACCode");
                        var bookingCompany = GetBookingCompany();

                        // Extract common values
                        string invBookingNumber, invHallName, invEventTypeName, invContactPerson;
                        string? invCompanyName;
                        DateTime invEventDate;
                        int invExpectedGuests;
                        int? invActualGuests;
                        decimal invHallRent, invDiscountAmount, invTaxableAmount, invTotalTax, invGrandTotal, invTotalPaid, invBalanceDue;
                        decimal invDiscountPct;
                        List<BanquetMenuChargeModel> invMenuCharges;
                        List<BanquetServiceChargeModel> invServiceCharges;
                        List<BanquetAdditionalChargeModel> invAdditionalCharges;
                        List<BanquetTaxSummaryModel> invTaxBreakdown;
                        decimal invMenuSub, invServiceSub, invAdditionalSub;

                        if (isFinalized)
                        {
                            invBookingNumber = invoice!.BookingNumber;
                            invHallName = invoice.HallName;
                            invEventTypeName = invoice.EventTypeName;
                            invContactPerson = invoice.ContactPersonName;
                            invCompanyName = invoice.CompanyName;
                            invEventDate = invoice.EventDate;
                            invExpectedGuests = invoice.ExpectedGuests;
                            invActualGuests = invoice.ActualGuests;
                            invHallRent = invoice.HallRent;
                            invDiscountAmount = invoice.DiscountAmount;
                            invMenuSub = invoice.MenuChargesSubtotal;
                            invServiceSub = invoice.ServiceChargesSubtotal;
                            invAdditionalSub = invoice.AdditionalChargesSubtotal;
                            var invSubtotal = invHallRent + invMenuSub + invServiceSub + invAdditionalSub;
                            invDiscountPct = invSubtotal > 0 ? Math.Round(invoice.DiscountAmount / invSubtotal * 100, 2) : 0;
                            invTaxableAmount = invoice.SubtotalBeforeTax;
                            invTotalTax = invoice.TotalTax;
                            invGrandTotal = invoice.GrandTotal;
                            invTotalPaid = invoice.TotalPaid;
                            invBalanceDue = invoice.BalanceDue;
                            invMenuCharges = invoice.MenuCharges;
                            invServiceCharges = invoice.ServiceCharges;
                            invAdditionalCharges = invoice.AdditionalCharges;
                            invTaxBreakdown = invoice.TaxBreakdown;
                        }
                        else
                        {
                            invBookingNumber = billPreview!.BookingNumber;
                            invHallName = billPreview.HallName;
                            invEventTypeName = billPreview.EventTypeName;
                            invContactPerson = billPreview.ContactPersonName;
                            invCompanyName = billPreview.CompanyName;
                            invEventDate = billPreview.EventDate;
                            invExpectedGuests = billPreview.ExpectedGuests;
                            invActualGuests = billPreview.ActualGuests;
                            invHallRent = billPreview.HallRent;
                            invDiscountAmount = billPreview.DiscountAmount;
                            invDiscountPct = billPreview.DiscountPercentage;
                            invMenuSub = billPreview.MenuChargesSubtotal;
                            invServiceSub = billPreview.ServiceChargesSubtotal;
                            invAdditionalSub = billPreview.AdditionalChargesSubtotal;
                            invTaxableAmount = billPreview.SubtotalAfterDiscount;
                            invTotalTax = billPreview.TotalTax;
                            invGrandTotal = billPreview.GrandTotal;
                            invTotalPaid = billPreview.TotalPaid;
                            invBalanceDue = billPreview.BalanceDue;
                            invMenuCharges = billPreview.MenuCharges;
                            invServiceCharges = billPreview.ServiceCharges;
                            invAdditionalCharges = billPreview.AdditionalCharges;
                            invTaxBreakdown = billPreview.TaxBreakdown;
                        }

                        var invSubtotalAll = invHallRent + invMenuSub + invServiceSub + invAdditionalSub;

                        // Build line items (skip rows with zero amount)
                        var lineItems = new List<(string Name, string Sac, int Qty, decimal Rate, decimal Amount, decimal CgstPct, decimal SgstPct, decimal IgstPct, decimal TaxAmt)>();
                        if (invHallRent > 0)
                            lineItems.Add(("Hall Rent", sacCode, 1, invHallRent, invHallRent, 0, 0, 0, 0));
                        foreach (var m in invMenuCharges)
                            if (m.TotalAmount > 0)
                                lineItems.Add((m.ItemName ?? m.PackageName ?? "Menu Item", m.SACCode ?? sacCode, m.Quantity, m.RatePerPlate, m.TotalAmount, m.ApplyTax ? m.CgstPercentage : 0, m.ApplyTax ? m.SgstPercentage : 0, m.ApplyTax ? m.IgstPercentage : 0, m.TaxAmount));
                        foreach (var s in invServiceCharges)
                            if (s.TotalAmount > 0)
                                lineItems.Add((s.ServiceName, s.SACCode ?? sacCode, s.Quantity, s.Rate, s.TotalAmount, s.ApplyTax ? s.CgstPercentage : 0, s.ApplyTax ? s.SgstPercentage : 0, s.ApplyTax ? s.IgstPercentage : 0, s.TaxAmount));
                        foreach (var c in invAdditionalCharges)
                            if (c.TotalAmount > 0)
                                lineItems.Add(($"{c.ChargeType} - {c.Description}", c.SACCode ?? "", c.Quantity, c.Amount, c.TotalAmount, c.ApplyTax ? c.CgstPercentage : 0, c.ApplyTax ? c.SgstPercentage : 0, c.ApplyTax ? c.IgstPercentage : 0, c.TaxAmount));

                        var footColSpan = 5;
                        var taxColSpan = isCgstSgst ? 3 : 2;
                        var hotelName = GetHotelSetting("HotelName");

                    <div class="gst-invoice" id="printable-invoice">
                        @if (!string.IsNullOrEmpty(billHeadingImagePath))
                        {
                            <div class="gst-invoice-heading-img">
                                <img src="@($"{apiBaseUrl}{billHeadingImagePath}")" alt="Bill Heading" />
                            </div>
                        }

                        <div class="gst-invoice-header">
                            <div class="gst-invoice-header-left">
                                @if (!string.IsNullOrEmpty(hotelName))
                                {
                                    <h3>@hotelName</h3>
                                }
                                @{ var hotelAddr = GetHotelSetting("HotelAddress"); }
                                @if (!string.IsNullOrEmpty(hotelAddr))
                                {
                                    <p>@hotelAddr</p>
                                }
                                @{
                                    var hotelPhone = GetHotelSetting("HotelPhone");
                                    var hotelEmail = GetHotelSetting("HotelEmail");
                                }
                                @if (!string.IsNullOrEmpty(hotelPhone) || !string.IsNullOrEmpty(hotelEmail))
                                {
                                    <p>
                                        @if (!string.IsNullOrEmpty(hotelPhone)) { <span>Phone: @hotelPhone</span> }
                                        @if (!string.IsNullOrEmpty(hotelPhone) && !string.IsNullOrEmpty(hotelEmail)) { <span> | </span> }
                                        @if (!string.IsNullOrEmpty(hotelEmail)) { <span>Email: @hotelEmail</span> }
                                    </p>
                                }
                                @{ var hotelGstin = GetHotelSetting("HotelGSTIN"); }
                                @if (!string.IsNullOrEmpty(hotelGstin))
                                {
                                    <p><strong>GSTIN:</strong> @hotelGstin</p>
                                }
                                @{ var stateCode = GetHotelSetting("HotelStateCode"); }
                                @if (!string.IsNullOrEmpty(stateCode))
                                {
                                    <p><strong>State:</strong> @stateCode</p>
                                }
                            </div>
                            <div class="gst-invoice-header-right">
                                <h4>@(isFinalized ? "Tax Invoice" : "Bill Preview")</h4>
                                @if (isFinalized)
                                {
                                    <p><strong>Invoice #:</strong> @invoice!.InvoiceNumber</p>
                                    <p><strong>Date:</strong> @invoice.InvoiceDate.ToString("MMM dd, yyyy")</p>
                                }
                                else
                                {
                                    <p><strong>Date:</strong> @DateTime.Today.ToString("MMM dd, yyyy")</p>
                                }
                                <p><strong>Booking #:</strong> @invBookingNumber</p>
                            </div>
                        </div>

                        <div class="gst-invoice-parties">
                            <div>
                                <h6>Bill To</h6>
                                @if (bookingCompany != null)
                                {
                                    <p class="party-name">@bookingCompany.CompanyName</p>
                                    @if (!string.IsNullOrEmpty(bookingCompany.Address))
                                    {
                                        <p>@bookingCompany.Address@(!string.IsNullOrEmpty(bookingCompany.City) ? $", {bookingCompany.City}" : "")@(!string.IsNullOrEmpty(bookingCompany.State) ? $", {bookingCompany.State}" : "")</p>
                                    }
                                    @if (!string.IsNullOrEmpty(bookingCompany.GSTNumber))
                                    {
                                        <p><strong>GSTIN:</strong> @bookingCompany.GSTNumber</p>
                                    }
                                }
                                <p><strong>Contact:</strong> @invContactPerson</p>
                                @if (!string.IsNullOrEmpty(booking?.ContactPhone))
                                {
                                    <p><strong>Phone:</strong> @booking.ContactPhone</p>
                                }
                            </div>
                            <div>
                                <h6>Event Details</h6>
                                <p><strong>Hall:</strong> @invHallName</p>
                                <p><strong>Event:</strong> @invEventTypeName</p>
                                <p><strong>Date:</strong> @invEventDate.ToString("MMM dd, yyyy")</p>
                                <p><strong>Guests:</strong> @(invActualGuests ?? invExpectedGuests)</p>
                            </div>
                        </div>

                        <table class="gst-invoice-items">
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th style="text-align:left;">Particulars</th>
                                    <th>SAC</th>
                                    <th>Qty</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                    @if (isCgstSgst)
                                    {
                                        <th>CGST %</th>
                                        <th>SGST %</th>
                                    }
                                    else
                                    {
                                        <th>IGST %</th>
                                    }
                                    <th>Tax Amt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < lineItems.Count; i++)
                                {
                                    var item = lineItems[i];
                                    <tr>
                                        <td class="text-center">@(i + 1)</td>
                                        <td>@item.Name</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(item.Sac) ? "-" : item.Sac)</td>
                                        <td class="text-center">@item.Qty</td>
                                        <td class="text-end">@item.Rate.ToString("N2")</td>
                                        <td class="text-end">@item.Amount.ToString("N2")</td>
                                        @if (isCgstSgst)
                                        {
                                            <td class="text-center">@(item.CgstPct > 0 ? item.CgstPct.ToString("0.##") : "-")</td>
                                            <td class="text-center">@(item.SgstPct > 0 ? item.SgstPct.ToString("0.##") : "-")</td>
                                        }
                                        else
                                        {
                                            <td class="text-center">@(item.IgstPct > 0 ? item.IgstPct.ToString("0.##") : "-")</td>
                                        }
                                        <td class="text-end">@(item.TaxAmt > 0 ? item.TaxAmt.ToString("N2") : "-")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="@footColSpan" class="text-end"><strong>Subtotal</strong></td>
                                    <td class="text-end"><strong>@invSubtotalAll.ToString("N2")</strong></td>
                                    <td colspan="@taxColSpan"></td>
                                </tr>
                                @if (invDiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="@footColSpan" class="text-end">Discount (@invDiscountPct%)</td>
                                        <td class="text-end" style="color:#dc3545;">-@invDiscountAmount.ToString("N2")</td>
                                        <td colspan="@taxColSpan"></td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="@footColSpan" class="text-end"><strong>Taxable Amount</strong></td>
                                    <td class="text-end"><strong>@invTaxableAmount.ToString("N2")</strong></td>
                                    <td colspan="@taxColSpan"></td>
                                </tr>
                                @foreach (var t in invTaxBreakdown)
                                {
                                    <tr>
                                        <td colspan="@footColSpan" class="text-end">@t.TaxType @@ @t.TaxPercentage%</td>
                                        <td></td>
                                        <td colspan="@(taxColSpan - 1)"></td>
                                        <td class="text-end">@t.TotalTaxAmount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="grand-total">
                                    <td colspan="@footColSpan" class="text-end">GRAND TOTAL</td>
                                    <td colspan="@(taxColSpan + 1)" class="text-end" style="font-size:15px;">@invGrandTotal.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="gst-invoice-amount-words">
                            <strong>Amount in Words:</strong> @NumberToWordsConverter.ConvertToIndianRupees(invGrandTotal)
                        </div>

                        @if (isFinalized && invoice!.PaymentHistory != null && invoice.PaymentHistory.Any())
                        {
                            <div class="gst-invoice-payments">
                                <h6>Payment History</h6>
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Receipt #</th>
                                            <th>Mode</th>
                                            <th>Type</th>
                                            <th style="text-align:right;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in invoice.PaymentHistory)
                                        {
                                            <tr>
                                                <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                                <td>@p.ReceiptNumber</td>
                                                <td>@p.PaymentMode</td>
                                                <td>@p.PaymentType</td>
                                                <td style="text-align:right;">@p.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="payment-summary">
                                    <span>Total Paid: <strong>@invTotalPaid.ToString("N2")</strong></span>
                                    <span>Balance Due: <strong class="@(invBalanceDue > 0 ? "text-danger" : "text-success")">@invBalanceDue.ToString("N2")</strong></span>
                                </div>
                            </div>
                        }

                        @{
                            var bankDetails = GetHotelSetting("BankDetails");
                            var invoiceTerms = GetHotelSetting("InvoiceTerms");
                        }
                        @if (!string.IsNullOrEmpty(bankDetails) || !string.IsNullOrEmpty(invoiceTerms))
                        {
                            <div class="gst-invoice-footer">
                                @if (!string.IsNullOrEmpty(bankDetails))
                                {
                                    <p><strong>Bank Details:</strong> @bankDetails</p>
                                }
                                @if (!string.IsNullOrEmpty(invoiceTerms))
                                {
                                    <p><strong>Terms & Conditions:</strong> @invoiceTerms</p>
                                }
                            </div>
                        }

                        <div class="gst-invoice-signature">
                            <div class="gst-invoice-signature-left">
                                @{ var footerNote = GetHotelSetting("InvoiceFooterNote"); }
                                @if (!string.IsNullOrEmpty(footerNote))
                                {
                                    @footerNote
                                }
                            </div>
                            <div class="gst-invoice-signature-right">
                                @if (!string.IsNullOrEmpty(hotelName))
                                {
                                    <div class="hotel-name">For @hotelName</div>
                                }
                                <div class="sig-label">Authorised Signatory</div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3 no-print">
                        <button class="btn btn-outline-secondary" @onclick="PrintInvoice"><i class="bi bi-printer"></i> @(isFinalized ? "Print Invoice" : "Print Preview")</button>
                    </div>
                }
                else
                {
                    <p class="text-muted">Click "Preview Bill" to see the billing breakdown.</p>
                }
            </div>
        </div>
    }
}


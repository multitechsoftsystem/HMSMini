@page "/day-closing"
@inject IApiClientService ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Day Closing - HMS Mini</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Day Closing</h3>
        <button class="btn btn-secondary" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }
    else
    {
        <!-- Working Date Section -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-check"></i> Working Date Information
                </h5>
            </div>
            <div class="card-body">
                @if (workingDate != null)
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Current Working Date</label>
                                <div class="fs-4 text-primary">
                                    @workingDate.WorkingDate.ToString("dddd, MMMM dd, yyyy")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">System Date</label>
                                <div class="fs-5">
                                    @workingDate.SystemDate.ToString("dddd, MMMM dd, yyyy")
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (workingDate.DaysBehindSystemDate > 0)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-circle"></i>
                            Working date is <strong>@workingDate.DaysBehindSystemDate day(s)</strong> behind system date.
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Validation Section -->
        @if (validation != null)
        {
            <div class="card mb-4">
                <div class="card-header @(validation.CanClose ? "bg-success" : "bg-warning") text-white">
                    <h5 class="mb-0">
                        <i class="bi @(validation.CanClose ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                        Day Close Validation
                    </h5>
                </div>
                <div class="card-body">
                    @if (validation.CanClose)
                    {
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle-fill"></i> All validation checks passed. Day can be closed.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>Cannot close day. Please resolve the following issues:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in validation.ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-door-open fs-4 me-3 text-primary"></i>
                                <div>
                                    <div class="text-muted small">Active Check-Ins</div>
                                    <div class="fs-5 fw-bold">@validation.ActiveCheckInsCount</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-receipt fs-4 me-3 text-warning"></i>
                                <div>
                                    <div class="text-muted small">Unposted Additional Charges</div>
                                    <div class="fs-5 fw-bold">@validation.UnpostedAdditionalChargesCount</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Preview Section -->
        @if (preview != null && validation?.CanClose == true)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-eye"></i> Day Close Preview
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Next Working Date</div>
                                    <div class="fs-5 fw-bold text-primary">
                                        @preview.NextWorkingDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Vouchers to Post</div>
                                    <div class="fs-5 fw-bold text-success">@preview.TotalVouchersToPost</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Total Revenue to Post</div>
                                    <div class="fs-5 fw-bold text-success">₹@preview.TotalRevenueToPost.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Voucher Summary by Type -->
                    @if (preview.VoucherSummary != null && preview.VoucherSummary.Any())
                    {
                        <h6 class="mb-3">Voucher Summary by Type</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Voucher Type</th>
                                        <th class="text-end">Count</th>
                                        <th class="text-end">Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var summary in preview.VoucherSummary)
                                    {
                                        <tr>
                                            <td>@summary.VoucherType</td>
                                            <td class="text-end">@summary.Count</td>
                                            <td class="text-end">₹@summary.TotalAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr class="fw-bold">
                                        <td>Total</td>
                                        <td class="text-end">@preview.VoucherSummary.Sum(v => v.Count)</td>
                                        <td class="text-end">₹@preview.VoucherSummary.Sum(v => v.TotalAmount).ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    <!-- Check-In Summary -->
                    @if (preview.CheckInSummaries != null && preview.CheckInSummaries.Any())
                    {
                        <h6 class="mb-3">Check-In Summary (@preview.CheckInSummaries.Count active check-ins)</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>Room</th>
                                        <th>Guest Name(s)</th>
                                        <th>Guest Type</th>
                                        <th class="text-end">Vouchers</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var checkIn in preview.CheckInSummaries)
                                    {
                                        <tr>
                                            <td>@checkIn.RoomNumber</td>
                                            <td>@checkIn.GuestNames</td>
                                            <td>
                                                @if (checkIn.IsComplimentary)
                                                {
                                                    <span class="badge bg-warning text-dark">@checkIn.GuestType</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@checkIn.GuestType</span>
                                                }
                                            </td>
                                            <td class="text-end">@checkIn.VouchersToPost</td>
                                            <td class="text-end">₹@checkIn.AmountToPost.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Close Day Button -->
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-danger btn-lg" @onclick="ConfirmCloseDay" disabled="@isClosingDay">
                            @if (isClosingDay)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <text>Closing Day...</text>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill"></i>
                                <text>Close Day</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Closing History -->
        @if (closingHistory != null && closingHistory.Any())
        {
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> Recent Closing History
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Closed Date</th>
                                    <th>Next Working Date</th>
                                    <th class="text-end">Active Check-Ins</th>
                                    <th class="text-end">Vouchers Posted</th>
                                    <th class="text-end">Revenue Posted</th>
                                    <th>Status</th>
                                    <th>Closed By</th>
                                    <th>Closed At</th>
                                    <th class="text-end">Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var history in closingHistory)
                                {
                                    <tr>
                                        <td>@history.ClosedDate.ToString("MMM dd, yyyy")</td>
                                        <td>@history.NextWorkingDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">@history.TotalActiveCheckIns</td>
                                        <td class="text-end">@history.TotalVouchersPosted</td>
                                        <td class="text-end">₹@history.TotalRevenuePosted.ToString("N2")</td>
                                        <td>
                                            @if (history.ClosingStatus == "Completed")
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Failed</span>
                                            }
                                        </td>
                                        <td>@history.ClosedBy</td>
                                        <td>@history.ClosedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td class="text-end">
                                            @if (history.DurationSeconds.HasValue)
                                            {
                                                <text>@history.DurationSeconds.Value s</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private WorkingDateModel? workingDate;
    private DayCloseValidationModel? validation;
    private DayClosePreviewModel? preview;
    private List<DayClosingAuditModel>? closingHistory;
    private bool isLoading = true;
    private bool isClosingDay = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Load all data in parallel
            var workingDateTask = ApiClient.GetWorkingDateAsync();
            var validationTask = ApiClient.ValidateDayCloseAsync();
            var historyTask = ApiClient.GetClosingHistoryAsync(10, 0);

            await Task.WhenAll(workingDateTask, validationTask, historyTask);

            workingDate = await workingDateTask;
            validation = await validationTask;
            closingHistory = await historyTask;

            // Load preview only if validation passes
            if (validation?.CanClose == true)
            {
                preview = await ApiClient.GetDayClosePreviewAsync();
            }
            else
            {
                preview = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading day closing data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmCloseDay()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to close the day for {workingDate?.WorkingDate:MMM dd, yyyy}?\n\n" +
            $"This will:\n" +
            $"- Post {preview?.TotalVouchersToPost} vouchers totaling ₹{preview?.TotalRevenueToPost:N2}\n" +
            $"- Advance working date to {preview?.NextWorkingDate:MMM dd, yyyy}\n" +
            $"- Lock all transactions for {workingDate?.WorkingDate:MMM dd, yyyy}\n\n" +
            "This operation cannot be easily undone.");

        if (confirmed)
        {
            await CloseDay();
        }
    }

    private async Task CloseDay()
    {
        isClosingDay = true;
        errorMessage = null;

        try
        {
            var result = await ApiClient.CloseDayAsync();

            if (result != null && result.Success)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    $"Day closed successfully!\n\n" +
                    $"Closed Date: {result.ClosedDate:MMM dd, yyyy}\n" +
                    $"New Working Date: {result.NewWorkingDate:MMM dd, yyyy}\n" +
                    $"Vouchers Posted: {result.TotalVouchersPosted}\n" +
                    $"Revenue Posted: ₹{result.TotalRevenuePosted:N2}\n" +
                    $"Duration: {result.DurationSeconds} seconds");

                // Reload data
                await LoadData();
            }
            else
            {
                errorMessage = result?.ErrorMessage ?? "Day close failed with unknown error.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error closing day: {ex.Message}";
        }
        finally
        {
            isClosingDay = false;
        }
    }

    private void ClearError()
    {
        errorMessage = null;
    }
}

@page "/rooms"
@inject IApiClientService ApiClient
@inject IAuthenticationService AuthService
@inject IJSRuntime JSRuntime
@using HMSMini.Web.Services
@using HMSMini.Web.Models

<PageTitle>Rooms - MSS</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Rooms</h2>
        @if (canManageRooms)
        {
            <div>
                <button class="btn btn-primary me-2" @onclick="ShowCreateRoomModal">
                    <i class="bi bi-plus-circle"></i> New Room
                </button>
                <button class="btn btn-outline-primary" @onclick="ShowManageRoomTypesModal">
                    <i class="bi bi-gear"></i> Manage Room Types
                </button>
            </div>
        }
    </div>

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border"></div>
        </div>
    }
    else if (rooms.Any())
    {
        <!-- Status Summary -->
        <div class="status-summary mb-4">
            <div class="status-card available @(activeFilter == 0 ? "active-filter" : "")"
                 @onclick="() => FilterByStatus(0)"
                 style="cursor: pointer;">
                <div class="status-label">Available</div>
                <div class="status-count">@rooms.Count(r => r.RoomStatus == 0)</div>
            </div>
            <div class="status-card occupied @(activeFilter == 1 ? "active-filter" : "")"
                 @onclick="() => FilterByStatus(1)"
                 style="cursor: pointer;">
                <div class="status-label">Occupied</div>
                <div class="status-count">@rooms.Count(r => r.RoomStatus == 1)</div>
            </div>
            <div class="status-card dirty @(activeFilter == 2 ? "active-filter" : "")"
                 @onclick="() => FilterByStatus(2)"
                 style="cursor: pointer;">
                <div class="status-label">Dirty</div>
                <div class="status-count">@rooms.Count(r => r.RoomStatus == 2)</div>
            </div>
            <div class="status-card maintenance @(activeFilter == 3 ? "active-filter" : "")"
                 @onclick="() => FilterByStatus(3)"
                 style="cursor: pointer;">
                <div class="status-label">Maintenance</div>
                <div class="status-count">@rooms.Count(r => r.RoomStatus == 3)</div>
            </div>
            <div class="status-card blocked @(activeFilter == 4 ? "active-filter" : "")"
                 @onclick="() => FilterByStatus(4)"
                 style="cursor: pointer;">
                <div class="status-label">Blocked</div>
                <div class="status-count">@rooms.Count(r => r.RoomStatus == 4)</div>
            </div>
        </div>

        <!-- Filter Status Indicator -->
        @if (activeFilter.HasValue)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center mb-3">
                <span>
                    <i class="bi bi-filter"></i>
                    Showing @FilteredRooms.Count() of @rooms.Count rooms -
                    Status: <strong>@((RoomStatus)activeFilter.Value)</strong>
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => activeFilter = null">
                    <i class="bi bi-x-circle"></i> Clear Filter
                </button>
            </div>
        }

        <!-- Room Cards -->
        <div class="room-chart">
            @foreach (var room in FilteredRooms)
            {
                <div class="room-card @GetRoomStatusClass(room.RoomStatus)">
                    <div>
                        <div class="room-number">@room.RoomNumber</div>
                        <div class="room-type">@room.RoomTypeName</div>
                        <span class="room-status-badge bg-@GetStatusColor(room.RoomStatus)">
                            @room.RoomStatusName
                        </span>
                    </div>

                    @if ((room.RoomStatus == 3 || room.RoomStatus == 4) && room.RoomStatusFromDate.HasValue && room.RoomStatusToDate.HasValue)
                    {
                        <div class="room-guest-info">
                            <div class="room-checkout-date">
                                <i class="bi bi-@(room.RoomStatus == 3 ? "tools" : "ban")"></i> @room.RoomStatusFromDate.Value.ToShortDateString() - @room.RoomStatusToDate.Value.ToShortDateString()
                            </div>
                        </div>
                    }

                    <div class="room-actions mt-2">
                        @if (room.RoomStatus == 0)
                        {
                            <button class="btn btn-sm btn-secondary" @onclick="() => ShowMaintenanceModal(room)">
                                <i class="bi bi-tools"></i> Maintenance
                            </button>
                            <button class="btn btn-sm btn-info" @onclick="() => ShowBlockModal(room)">
                                <i class="bi bi-ban"></i> Block
                            </button>
                        }
                        else if (room.RoomStatus == 3)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ReleaseFromMaintenance(room)">
                                <i class="bi bi-check-circle"></i> Release
                            </button>
                        }
                        else if (room.RoomStatus == 4)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => UnblockRoom(room)">
                                <i class="bi bi-unlock"></i> Unblock
                            </button>
                        }
                        else if (room.RoomStatus == 2)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => SetToAvailable(room)">
                                <i class="bi bi-check-circle"></i> Clean
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No rooms available</p>
    }
</div>

<!-- Maintenance Modal -->
@if (showMaintenanceModal && selectedRoom != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Set Room to Maintenance</h5>
                    <button type="button" class="btn-close" @onclick="HideMaintenanceModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    <p><strong>Room:</strong> @selectedRoom.RoomNumber (@selectedRoom.RoomTypeName)</p>
                    <div class="mb-3">
                        <label>From Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="maintenanceFromDate" />
                    </div>
                    <div class="mb-3">
                        <label>To Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="maintenanceToDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideMaintenanceModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SetToMaintenance">Set Maintenance</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Block Modal -->
@if (showBlockModal && selectedRoom != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Block Room</h5>
                    <button type="button" class="btn-close" @onclick="HideBlockModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    <p><strong>Room:</strong> @selectedRoom.RoomNumber (@selectedRoom.RoomTypeName)</p>
                    <div class="mb-3">
                        <label>From Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="blockFromDate" />
                    </div>
                    <div class="mb-3">
                        <label>To Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="blockToDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideBlockModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="BlockRoom">Block Room</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Create Room Modal -->
@if (showCreateRoomModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Room</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateRoomModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createRoomError))
                    {
                        <div class="alert alert-danger">@createRoomError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Room Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="newRoom.RoomNumber" placeholder="e.g., 101, 202" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Room Type <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="newRoom.RoomTypeId">
                            <option value="0">-- Select Room Type --</option>
                            @foreach (var type in roomTypes)
                            {
                                <option value="@type.RoomTypeId">@type.RoomType</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateRoomModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateRoom" disabled="@creatingRoom">
                        @if (creatingRoom)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Create Room
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Manage Room Types Modal -->
@if (showManageRoomTypesModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Room Types</h5>
                    <button type="button" class="btn-close" @onclick="HideManageRoomTypesModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(roomTypeError))
                    {
                        <div class="alert alert-danger">@roomTypeError</div>
                    }

                    @if (!showEditRoomTypeModal)
                    {
                        <button class="btn btn-primary mb-3" @onclick="ShowNewRoomTypeForm">
                            <i class="bi bi-plus-circle"></i> Add New Room Type
                        </button>

                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Room Type</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var type in roomTypes)
                                {
                                    <tr>
                                        <td><strong>@type.RoomType</strong></td>
                                        <td>@type.RoomDescription</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditRoomTypeForm(type)">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoomType(type.RoomTypeId)">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <h6>@(editingRoomTypeId == 0 ? "New Room Type" : "Edit Room Type")</h6>

                        @if (editingRoomTypeId == 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Room Type <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="newRoomType.RoomType" placeholder="e.g., Deluxe, Suite" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" rows="3" @bind="newRoomType.RoomDescription" placeholder="Describe the room type..."></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Room Type <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="editRoomType.RoomType" placeholder="e.g., Deluxe, Suite" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" rows="3" @bind="editRoomType.RoomDescription" placeholder="Describe the room type..."></textarea>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary" @onclick="() => { showEditRoomTypeModal = false; editingRoomTypeId = 0; }">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveRoomType" disabled="@savingRoomType">
                                @if (savingRoomType)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Save
                            </button>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideManageRoomTypesModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RoomDto> rooms = new();
    private bool loading = true;

    // Filtering state
    private int? activeFilter = null; // null = show all, 0-4 = specific status

    // Computed property for filtered rooms
    private IEnumerable<RoomDto> FilteredRooms
    {
        get
        {
            if (activeFilter.HasValue)
            {
                return rooms.Where(r => r.RoomStatus == activeFilter.Value).OrderBy(r => r.RoomNumber);
            }
            return rooms.OrderBy(r => r.RoomNumber);
        }
    }

    // Modal state
    private bool showMaintenanceModal = false;
    private bool showBlockModal = false;
    private RoomDto? selectedRoom = null;
    private string errorMessage = "";

    // Date selections
    private DateTime maintenanceFromDate = DateTime.Today;
    private DateTime maintenanceToDate = DateTime.Today.AddDays(1);
    private DateTime blockFromDate = DateTime.Today;
    private DateTime blockToDate = DateTime.Today.AddDays(1);

    // Role-based permissions
    private bool canManageRooms = false;

    // Room creation modal
    private bool showCreateRoomModal = false;
    private CreateRoomDto newRoom = new();
    private List<RoomTypeDto> roomTypes = new();
    private bool creatingRoom = false;
    private string createRoomError = string.Empty;

    // Room type management modal
    private bool showManageRoomTypesModal = false;
    private bool showEditRoomTypeModal = false;
    private CreateRoomTypeDto newRoomType = new();
    private UpdateRoomTypeDto editRoomType = new();
    private int editingRoomTypeId = 0;
    private bool savingRoomType = false;
    private string roomTypeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserPermissions();
        await LoadRooms();
        await LoadRoomTypes();
    }

    private async Task CheckUserPermissions()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            canManageRooms = currentUser.Role == 0 || currentUser.Role == 1;
        }
    }

    private async Task LoadRooms()
    {
        loading = true;
        rooms = await ApiClient.GetRoomsAsync();
        loading = false;
    }

    private void ShowMaintenanceModal(RoomDto room)
    {
        selectedRoom = room;
        maintenanceFromDate = DateTime.Today;
        maintenanceToDate = DateTime.Today.AddDays(1);
        errorMessage = "";
        showMaintenanceModal = true;
    }

    private void HideMaintenanceModal()
    {
        showMaintenanceModal = false;
        selectedRoom = null;
        errorMessage = "";
    }

    private async Task SetToMaintenance()
    {
        if (selectedRoom == null) return;

        errorMessage = "";

        if (maintenanceToDate <= maintenanceFromDate)
        {
            errorMessage = "To Date must be after From Date";
            return;
        }

        var dto = new UpdateRoomStatusDto
        {
            RoomStatus = 3, // Maintenance
            RoomStatusFromDate = maintenanceFromDate,
            RoomStatusToDate = maintenanceToDate
        };

        var result = await ApiClient.UpdateRoomStatusAsync(selectedRoom.RoomId, dto);
        if (result != null)
        {
            await LoadRooms();
            HideMaintenanceModal();
        }
        else
        {
            errorMessage = "Failed to set room to maintenance. Please try again.";
        }
    }

    private void ShowBlockModal(RoomDto room)
    {
        selectedRoom = room;
        blockFromDate = DateTime.Today;
        blockToDate = DateTime.Today.AddDays(1);
        errorMessage = "";
        showBlockModal = true;
    }

    private void HideBlockModal()
    {
        showBlockModal = false;
        selectedRoom = null;
        errorMessage = "";
    }

    private async Task BlockRoom()
    {
        if (selectedRoom == null) return;

        errorMessage = "";

        if (blockToDate <= blockFromDate)
        {
            errorMessage = "To Date must be after From Date";
            return;
        }

        var dto = new UpdateRoomStatusDto
        {
            RoomStatus = 4, // Blocked
            RoomStatusFromDate = blockFromDate,
            RoomStatusToDate = blockToDate
        };

        var result = await ApiClient.UpdateRoomStatusAsync(selectedRoom.RoomId, dto);
        if (result != null)
        {
            await LoadRooms();
            HideBlockModal();
        }
        else
        {
            errorMessage = "Failed to block room. Please try again.";
        }
    }

    private async Task ReleaseFromMaintenance(RoomDto room)
    {
        var dto = new UpdateRoomStatusDto
        {
            RoomStatus = 0, // Available
            RoomStatusFromDate = null,
            RoomStatusToDate = null
        };

        var result = await ApiClient.UpdateRoomStatusAsync(room.RoomId, dto, fromStatus: 3); // From Maintenance
        if (result != null)
        {
            await LoadRooms();
        }
    }

    private async Task UnblockRoom(RoomDto room)
    {
        var dto = new UpdateRoomStatusDto
        {
            RoomStatus = 0, // Available
            RoomStatusFromDate = null,
            RoomStatusToDate = null
        };

        var result = await ApiClient.UpdateRoomStatusAsync(room.RoomId, dto, fromStatus: 4); // From Blocked
        if (result != null)
        {
            await LoadRooms();
        }
    }

    private async Task SetToAvailable(RoomDto room)
    {
        var dto = new UpdateRoomStatusDto
        {
            RoomStatus = 0, // Available
            RoomStatusFromDate = null,
            RoomStatusToDate = null
        };

        var result = await ApiClient.UpdateRoomStatusAsync(room.RoomId, dto);
        if (result != null)
        {
            await LoadRooms();
        }
    }

    private string GetRoomStatusClass(int status)
    {
        return status switch
        {
            0 => "available",
            1 => "occupied",
            2 => "dirty",
            3 => "maintenance",
            4 => "blocked",
            _ => "available"
        };
    }

    private string GetStatusColor(int status)
    {
        return status switch
        {
            0 => "success",      // Available - Green
            1 => "danger",       // Occupied - Red
            2 => "warning",      // Dirty - Yellow
            3 => "secondary",    // Maintenance - Gray
            4 => "info",         // Blocked - Blue (distinct from all others)
            _ => "secondary"
        };
    }

    private void FilterByStatus(int status)
    {
        // Toggle behavior: if clicking the same filter, clear it
        if (activeFilter == status)
        {
            activeFilter = null; // Show all rooms
        }
        else
        {
            activeFilter = status; // Filter by this status
        }
    }

    private async Task LoadRoomTypes()
    {
        roomTypes = await ApiClient.GetRoomTypesAsync();
    }

    private void ShowCreateRoomModal()
    {
        newRoom = new CreateRoomDto();
        createRoomError = string.Empty;
        showCreateRoomModal = true;
    }

    private void HideCreateRoomModal()
    {
        showCreateRoomModal = false;
        newRoom = new();
    }

    private async Task CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoom.RoomNumber))
        {
            createRoomError = "Room number is required";
            return;
        }

        if (newRoom.RoomTypeId == 0)
        {
            createRoomError = "Please select a room type";
            return;
        }

        creatingRoom = true;
        try
        {
            await ApiClient.CreateRoomAsync(newRoom);
            await LoadRooms();
            HideCreateRoomModal();
        }
        catch (Exception ex)
        {
            createRoomError = $"Failed to create room: {ex.Message}";
        }
        finally
        {
            creatingRoom = false;
        }
    }

    private void ShowManageRoomTypesModal()
    {
        showManageRoomTypesModal = true;
        roomTypeError = string.Empty;
    }

    private void HideManageRoomTypesModal()
    {
        showManageRoomTypesModal = false;
        showEditRoomTypeModal = false;
    }

    private void ShowNewRoomTypeForm()
    {
        newRoomType = new();
        editingRoomTypeId = 0;
        showEditRoomTypeModal = true;
    }

    private void ShowEditRoomTypeForm(RoomTypeDto roomType)
    {
        editRoomType = new UpdateRoomTypeDto
        {
            RoomType = roomType.RoomType,
            RoomDescription = roomType.RoomDescription
        };
        editingRoomTypeId = roomType.RoomTypeId;
        showEditRoomTypeModal = true;
    }

    private async Task SaveRoomType()
    {
        savingRoomType = true;
        roomTypeError = string.Empty;

        try
        {
            if (editingRoomTypeId == 0)
            {
                await ApiClient.CreateRoomTypeAsync(new CreateRoomTypeDto
                {
                    RoomType = newRoomType.RoomType,
                    RoomDescription = newRoomType.RoomDescription
                });
            }
            else
            {
                await ApiClient.UpdateRoomTypeAsync(editingRoomTypeId, editRoomType);
            }

            await LoadRoomTypes();
            await LoadRooms();
            showEditRoomTypeModal = false;
            editingRoomTypeId = 0;
        }
        catch (Exception ex)
        {
            roomTypeError = $"Failed to save room type: {ex.Message}";
        }
        finally
        {
            savingRoomType = false;
        }
    }

    private async Task DeleteRoomType(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this room type?"))
            return;

        try
        {
            await ApiClient.DeleteRoomTypeAsync(id);
            await LoadRoomTypes();
            await LoadRooms();
        }
        catch (Exception ex)
        {
            roomTypeError = $"Failed to delete: {ex.Message}. Room type may be in use.";
        }
    }
}

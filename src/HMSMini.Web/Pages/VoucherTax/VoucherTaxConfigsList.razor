@page "/voucher-tax-configs"
@inject IApiClientService ApiClient
@inject IJSRuntime JSRuntime
@inject IAuthenticationService AuthService
@using HMSMini.Web.Services
@using HMSMini.Web.Models

<PageTitle>Voucher Tax Configurations - MSS</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-receipt"></i> Voucher Tax Configurations</h2>
        <div>
            <button class="btn btn-outline-primary me-2" @onclick="LoadConfigs">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            @if (canManageMasterData)
            {
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="bi bi-plus-circle"></i> Add Configuration
                </button>
            }
        </div>
    </div>

    @if (!canManageMasterData)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> You have view-only access. Contact an administrator to make changes.
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (configs.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Configured Voucher Types</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Voucher Type</th>
                                <th>CGST</th>
                                <th>SGST</th>
                                <th>IGST</th>
                                <th>Total (CGST+SGST)</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var config in configs.OrderBy(c => c.DisplayOrder))
                            {
                                <tr>
                                    <td><strong>@config.VoucherType</strong></td>
                                    <td><span class="badge bg-info">@config.CgstPercentage%</span></td>
                                    <td><span class="badge bg-info">@config.SgstPercentage%</span></td>
                                    <td><span class="badge bg-warning text-dark">@config.IgstPercentage%</span></td>
                                    <td><span class="badge bg-primary">@(config.CgstPercentage + config.SgstPercentage)%</span></td>
                                    <td><small class="text-muted">@config.Description</small></td>
                                    <td>
                                        @if (config.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (canManageMasterData)
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditModal(config)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteConfig(config.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">View Only</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="alert alert-info mt-3">
            <h6><i class="bi bi-info-circle"></i> How Voucher Tax Works:</h6>
            <ul class="mb-0">
                <li><strong>Voucher-Specific Rates:</strong> Each voucher type (Room Service, Laundry, etc.) has its own tax rate</li>
                <li><strong>CGST + SGST:</strong> Used for intra-state transactions (both percentages added together)</li>
                <li><strong>IGST:</strong> Used for inter-state transactions (single tax rate)</li>
                <li><strong>Check-In Tax Type:</strong> The tax type (CGST+SGST or IGST) is determined by the check-in settings</li>
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No voucher tax configurations found. Click "Add Configuration" to create one.
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (isEditing)
                        {
                            <span><i class="bi bi-pencil"></i> Edit Voucher Tax Configuration</span>
                        }
                        else
                        {
                            <span><i class="bi bi-plus-circle"></i> Add Voucher Tax Configuration</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Voucher Type <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="currentConfig.VoucherType" placeholder="e.g., Room Service, Laundry" />
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">CGST % <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="currentConfig.CgstPercentage" step="0.01" min="0" max="100" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">SGST % <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="currentConfig.SgstPercentage" step="0.01" min="0" max="100" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">IGST % <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="currentConfig.IgstPercentage" step="0.01" min="0" max="100" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="currentConfig.Description" rows="2" placeholder="Brief description of this tax configuration"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Display Order</label>
                            <input type="number" class="form-control" @bind="currentConfig.DisplayOrder" min="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="isActive" @bind="currentConfig.IsActive" />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong>Preview:</strong>
                        @if (currentConfig.CgstPercentage + currentConfig.SgstPercentage == currentConfig.IgstPercentage)
                        {
                            <span>GST @(currentConfig.CgstPercentage + currentConfig.SgstPercentage)% (CGST @currentConfig.CgstPercentage% + SGST @currentConfig.SgstPercentage%) or IGST @currentConfig.IgstPercentage%</span>
                        }
                        else
                        {
                            <span class="text-warning">Warning: CGST + SGST should equal IGST for consistency</span>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveConfig" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>@(isEditing ? "Update" : "Create")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VoucherTaxConfigModel> configs = new();
    private bool loading = true;
    private string? errorMessage;
    private string? successMessage;
    private bool showModal = false;
    private bool isEditing = false;
    private bool saving = false;
    private int editingId;

    private CreateVoucherTaxConfigModel currentConfig = new();

    // Role-based permissions
    private bool canManageMasterData = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserPermissions();
        await LoadConfigs();
    }

    private async Task CheckUserPermissions()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            // Only Admin (0) and Manager (1) can manage master data
            canManageMasterData = currentUser.Role == 0 || currentUser.Role == 1;
        }
    }

    private async Task LoadConfigs()
    {
        loading = true;
        errorMessage = null;

        try
        {
            configs = await ApiClient.GetVoucherTaxConfigsAsync();
            if (configs.Any())
            {
                successMessage = $"Loaded {configs.Count} voucher tax configurations";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading configurations: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        currentConfig = new CreateVoucherTaxConfigModel
        {
            IsActive = true,
            DisplayOrder = configs.Any() ? configs.Max(c => c.DisplayOrder) + 1 : 1
        };
        showModal = true;
        errorMessage = null;
        successMessage = null;
    }

    private void ShowEditModal(VoucherTaxConfigModel config)
    {
        isEditing = true;
        editingId = config.Id;
        currentConfig = new CreateVoucherTaxConfigModel
        {
            VoucherType = config.VoucherType,
            CgstPercentage = config.CgstPercentage,
            SgstPercentage = config.SgstPercentage,
            IgstPercentage = config.IgstPercentage,
            IsActive = config.IsActive,
            Description = config.Description,
            DisplayOrder = config.DisplayOrder
        };
        showModal = true;
        errorMessage = null;
        successMessage = null;
    }

    private void CloseModal()
    {
        showModal = false;
        currentConfig = new();
    }

    private async Task SaveConfig()
    {
        if (string.IsNullOrWhiteSpace(currentConfig.VoucherType))
        {
            errorMessage = "Voucher Type is required";
            return;
        }

        saving = true;
        errorMessage = null;

        try
        {
            VoucherTaxConfigModel? result;
            if (isEditing)
            {
                result = await ApiClient.UpdateVoucherTaxConfigAsync(editingId, currentConfig);
                successMessage = result != null ? $"Updated '{currentConfig.VoucherType}' successfully" : null;
            }
            else
            {
                result = await ApiClient.CreateVoucherTaxConfigAsync(currentConfig);
                successMessage = result != null ? $"Created '{currentConfig.VoucherType}' successfully" : null;
            }

            if (result != null)
            {
                await LoadConfigs();
                CloseModal();
            }
            else
            {
                errorMessage = isEditing ? "Failed to update configuration" : "Failed to create configuration";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving configuration: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteConfig(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this voucher tax configuration?"))
            return;

        errorMessage = null;

        try
        {
            var success = await ApiClient.DeleteVoucherTaxConfigAsync(id);
            if (success)
            {
                successMessage = "Voucher tax configuration deleted successfully";
                await LoadConfigs();
            }
            else
            {
                errorMessage = "Failed to delete voucher tax configuration";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting configuration: {ex.Message}";
        }
    }
}

@page "/taxslabs"
@inject IApiClientService ApiClient
@inject IAuthenticationService AuthService
@using HMSMini.Web.Services
@using HMSMini.Web.Models

<PageTitle>Tax Slabs - MSS</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calculator"></i> Tax Slabs Configuration</h2>
        <div>
            <button class="btn btn-outline-primary me-2" @onclick="LoadTaxSlabs">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (taxSlabs.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-table"></i> Active Tax Slabs</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Amount Range</th>
                                        <th>CGST</th>
                                        <th>SGST</th>
                                        <th>IGST</th>
                                        <th>Total (CGST+SGST)</th>
                                        <th>Effective From</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slab in taxSlabs.OrderBy(s => s.MinAmount))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@slab.AmountRangeDisplay</strong>
                                                @if (!string.IsNullOrEmpty(slab.Description))
                                                {
                                                    <br />
                                                    <small class="text-muted">@slab.Description</small>
                                                }
                                            </td>
                                            <td><span class="badge bg-info">@slab.CgstPercentage%</span></td>
                                            <td><span class="badge bg-info">@slab.SgstPercentage%</span></td>
                                            <td><span class="badge bg-warning text-dark">@slab.IgstPercentage%</span></td>
                                            <td><span class="badge bg-primary">@(slab.CgstPercentage + slab.SgstPercentage)%</span></td>
                                            <td>@slab.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (slab.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <h6><i class="bi bi-info-circle"></i> How Tax Slabs Work:</h6>
                    <ul class="mb-0">
                        <li><strong>Daily Basis:</strong> Each night's charges are calculated separately to determine the applicable tax slab</li>
                        <li><strong>CGST + SGST:</strong> Used for intra-state (within same state) transactions</li>
                        <li><strong>IGST:</strong> Used for inter-state (between different states) transactions</li>
                        <li><strong>Automatic Selection:</strong> Tax type is selected during check-in based on guest location</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-calculator-fill"></i> Tax Calculator</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Daily Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" class="form-control" @bind="calculatorAmount" step="0.01" min="0" placeholder="Enter amount" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tax Type</label>
                            <select class="form-select" @bind="calculatorTaxType">
                                <option value="0">CGST + SGST (Intra-state)</option>
                                <option value="1">IGST (Inter-state)</option>
                            </select>
                        </div>

                        <button class="btn btn-success w-100" @onclick="CalculateTax">
                            <i class="bi bi-calculator"></i> Calculate Tax
                        </button>

                        @if (calculationResult != null)
                        {
                            <div class="mt-3">
                                <hr />
                                <h6>Result:</h6>
                                <div class="bg-light p-3 rounded">
                                    <p class="mb-2"><strong>Amount:</strong> ₹@calculatorAmount.ToString("N2")</p>
                                    <p class="mb-2"><strong>Applicable Slab:</strong> @calculationResult.SlabRange</p>

                                    @if (calculatorTaxType == 0)
                                    {
                                        <p class="mb-1"><strong>CGST (@calculationResult.CgstPercentage%):</strong> ₹@((calculatorAmount * calculationResult.CgstPercentage / 100).ToString("N2"))</p>
                                        <p class="mb-2"><strong>SGST (@calculationResult.SgstPercentage%):</strong> ₹@((calculatorAmount * calculationResult.SgstPercentage / 100).ToString("N2"))</p>
                                        <p class="mb-0"><strong class="text-primary">Total Tax:</strong> <span class="text-primary">₹@((calculatorAmount * (calculationResult.CgstPercentage + calculationResult.SgstPercentage) / 100).ToString("N2"))</span></p>
                                    }
                                    else
                                    {
                                        <p class="mb-2"><strong>IGST (@calculationResult.IgstPercentage%):</strong> ₹@((calculatorAmount * calculationResult.IgstPercentage / 100).ToString("N2"))</p>
                                        <p class="mb-0"><strong class="text-primary">Total Tax:</strong> <span class="text-primary">₹@((calculatorAmount * calculationResult.IgstPercentage / 100).ToString("N2"))</span></p>
                                    }

                                    <hr />
                                    <p class="mb-0"><strong class="text-success">Grand Total:</strong> <span class="text-success fs-5">₹@((calculatorAmount + (calculatorTaxType == 0 ? calculatorAmount * (calculationResult.CgstPercentage + calculationResult.SgstPercentage) / 100 : calculatorAmount * calculationResult.IgstPercentage / 100)).ToString("N2"))</span></p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-warning">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Reference</h6>
                    </div>
                    <div class="card-body">
                        <small>
                            <p class="mb-2"><strong>GST 5%:</strong> Rooms up to ₹7,499.99 per night</p>
                            <p class="mb-0"><strong>GST 18%:</strong> Rooms ₹7,500 and above per night</p>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No tax slabs configured. Please contact system administrator.
        </div>
    }
</div>

@code {
    private List<TaxSlabModel> taxSlabs = new();
    private bool loading = true;
    private string? errorMessage;
    private string? successMessage;

    // Calculator variables
    private decimal calculatorAmount = 5000;
    private int calculatorTaxType = 0; // 0 = CGST+SGST, 1 = IGST
    private ApplicableTaxSlabModel? calculationResult;

    // Role-based permissions (for future use)
    private bool canManageMasterData = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserPermissions();
        await LoadTaxSlabs();
    }

    private async Task CheckUserPermissions()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            // Only Admin (0) and Manager (1) can manage master data
            canManageMasterData = currentUser.Role == 0 || currentUser.Role == 1;
        }
    }

    private async Task LoadTaxSlabs()
    {
        loading = true;
        errorMessage = null;

        try
        {
            taxSlabs = await ApiClient.GetActiveTaxSlabsAsync();

            if (taxSlabs.Any())
            {
                successMessage = $"Loaded {taxSlabs.Count} tax slabs successfully";
            }
            else
            {
                errorMessage = "No tax slabs found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tax slabs: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CalculateTax()
    {
        if (calculatorAmount <= 0)
        {
            errorMessage = "Please enter a valid amount greater than 0";
            return;
        }

        errorMessage = null;

        try
        {
            calculationResult = await ApiClient.GetApplicableTaxSlabAsync(calculatorAmount);

            if (calculationResult != null)
            {
                successMessage = "Tax calculated successfully";
            }
            else
            {
                errorMessage = "No applicable tax slab found for this amount";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error calculating tax: {ex.Message}";
        }
    }
}
